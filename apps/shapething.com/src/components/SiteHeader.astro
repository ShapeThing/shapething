---
const links = [
  { href: '/packages', label: 'Packages' },
  { href: '/examples', label: 'Examples' },
  { href: '/glossary', label: 'Glossary' },
  { href: 'https://github.com/ShapeThing/shapething', label: 'GitHub' },
]

// Astro may serve pages with a trailing slash, /examples/ is the same page as /examples.
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="site-header">
  <a class="site-link" href="/">
    <img class="site-logo" src="/logo.svg" alt="ShapeThing" />
  </a>
  <nav class="menu">
    {
      links.map(({ href, label }) => (
        <a class="menu-link" href={href} aria-current={href === currentPath ? 'page' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    isolation: isolate;
    margin-bottom: 1.5em;
    padding-block: 1em;
    width: 100%;
    max-width: var(--max-width);
    flex-wrap: wrap;
    display: flex;
    align-items: center;
    gap: 1em;
  }

  /* A tinted band across the full width of the window, the header content stays within the max width. */
  .site-header::before {
    content: '';
    position: absolute;
    z-index: -1;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 100%;
    transform: translateX(-50%);
    background: color-mix(in srgb, var(--blue-lightest) 30%, white);
    border-bottom: 1px solid var(--blue-lightest);
    box-shadow: 0 2px 8px rgb(0 68 170 / 0.06);
  }

  .site-logo {
    max-width: 220px;
    margin-top: 6px;
    margin-bottom: -6px;
  }

  .menu {
    margin-left: auto;
  }

  .menu-link {
    text-decoration: none;
    color: var(--blue-dark);
    font-weight: 500;
    padding: 0.5em 1em;
    border-radius: 0.5em;
  }

  .menu-link[aria-current='page'] {
    background: var(--blue-dark);
    color: white;
  }

  .menu-link:hover,
  .menu-link:focus-visible {
    background: white;
    color: var(--purple);
  }

  .menu-link[aria-current='page']:hover,
  .menu-link[aria-current='page']:focus-visible {
    background: var(--purple);
    color: white;
  }

  .menu-link:focus-visible {
    outline: 2px solid var(--blue-light);
    outline-offset: 2px;
  }

  .menu-link.app {
    background-color: var(--purple);
    font-style: italic;
    font-weight: 800;

    color: white;
  }
</style>
