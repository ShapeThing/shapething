<div class="fuzzy-search-example">
    <div class="search-bar">
        <input id="fuzzy-search-input" type="search" placeholder="Search recipes and chefs…" autocomplete="off" />
    </div>
    <div class="panes">
        <div class="pane">
            <span class="pane-label">query.rq</span>
            <pre id="fuzzy-search-query"></pre>
        </div>
        <div class="pane">
            <span class="pane-label" id="fuzzy-search-label">results</span>
            <ul id="fuzzy-search-results"></ul>
        </div>
    </div>
</div>

<script>
    // The TextStore and Comunica are large, only load them once the example is in view.
    const input = document.querySelector<HTMLInputElement>('#fuzzy-search-input')!
    const queryElement = document.querySelector<HTMLElement>('#fuzzy-search-query')!
    const labelElement = document.querySelector<HTMLElement>('#fuzzy-search-label')!
    const resultsElement = document.querySelector<HTMLElement>('#fuzzy-search-results')!

    const observer = new IntersectionObserver(
        async (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return
            observer.disconnect()
            const { search, searchQuery, onStoreChange } = await import('../examples/fuzzySearch')

            let lastRun = 0
            const render = async () => {
                const run = ++lastRun
                const text = input.value
                queryElement.textContent = searchQuery(text)

                try {
                    const { label, results } = await search(text)
                    if (run !== lastRun) return
                    labelElement.textContent = `results (${label})`

                    resultsElement.replaceChildren(
                        ...results.map(({ resource, type, name, matches }) => {
                            const item = document.createElement('li')
                            const title = document.createElement('strong')
                            title.textContent = name
                            const meta = document.createElement('span')
                            meta.className = 'meta'
                            meta.textContent = `${type} · ${resource}`
                            const matchList = document.createElement('ul')
                            matchList.className = 'matches'
                            matchList.append(
                                ...matches.map(({ property, value }) => {
                                    const match = document.createElement('li')
                                    match.textContent = `${property}: ${value}`
                                    return match
                                })
                            )
                            item.append(title, meta, matchList)
                            return item
                        })
                    )
                    if (text.trim() && !results.length) resultsElement.replaceChildren(Object.assign(document.createElement('li'), { textContent: 'No results.' }))
                } catch (error) {
                    if (run !== lastRun) return
                    console.error(error)
                    resultsElement.replaceChildren(
                        Object.assign(document.createElement('li'), { className: 'error', textContent: error instanceof Error ? error.message : String(error) })
                    )
                }
            }

            let timeout: ReturnType<typeof setTimeout>
            input.addEventListener('input', () => {
                clearTimeout(timeout)
                timeout = setTimeout(render, 150)
            })

            for (const button of document.querySelectorAll<HTMLButtonElement>('.fuzzy-search-example [data-search]')) {
                button.addEventListener('click', () => {
                    input.value = button.dataset.search!
                    render()
                })
            }

            onStoreChange(render)
            render()
        },
        { rootMargin: '400px' }
    )

    observer.observe(input)
</script>

<style>
    .fuzzy-search-example {
        display: flex;
        flex-direction: column;
        gap: 1em;
        font-size: 15px;
    }

    .search-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.6em 1em;
    }

    #fuzzy-search-input {
        flex: 1 1 260px;
        font: inherit;
        padding: 0.5em 0.8em;
        border: 1px solid var(--blue-light);
        border-radius: 6px;
        color: inherit;
    }
    .panes {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
        gap: 1em;
    }

    .pane {
        min-width: 0;
        border: 1px solid var(--blue-lightest);
        border-radius: 6px;
        overflow: hidden;
    }

    .pane-label {
        display: block;
        padding: 0.3em 0.8em;
        background: var(--blue-lightest);
        font-family: monospace;
        font-size: 13px;
    }

    #fuzzy-search-query {
        margin: 0;
        padding: 0.6em 0.8em;
        overflow-x: auto;
        font-size: 13px;
    }

    #fuzzy-search-results {
        list-style: none;
        margin: 0;
        padding: 0.4em 0.8em;
        min-height: 10em;
    }

    #fuzzy-search-results > :global(li) {
        padding: 0.5em 0;
        border-bottom: 1px solid var(--blue-lightest);
    }

    #fuzzy-search-results > :global(li:last-child) {
        border-bottom: none;
    }

    #fuzzy-search-results :global(.meta) {
        margin-left: 0.6em;
        font-family: monospace;
        font-size: 12px;
        color: var(--blue-light);
    }

    #fuzzy-search-results :global(.matches) {
        margin: 0.3em 0 0;
        padding-left: 1.2em;
        font-size: 13px;
        color: var(--purple-dark);
    }

    #fuzzy-search-results :global(.error) {
        color: var(--purple);
    }
</style>
