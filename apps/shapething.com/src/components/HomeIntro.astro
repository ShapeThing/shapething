---
import { examples } from '../data/examples'
import Term from './Term.astro'

---

<section class="intro">
  <div class="intro__columns">
    <div class="intro__hero">
      <h1>Build web apps on <Term id="linked-data">linked data</Term>, with TypeScript</h1>
      <p class="intro__lead">
        ShapeThing is a set of TypeScript libraries for building apps on linked data, in the browser and in Node. Describe your
        data once as a <Term id="shape">shape</Term>. From that one description you get typed queries, complete documents,
        forms, TypeScript types and test data.
      </p>

      <div class="intro__examples">
        <h2>See it in action</h2>
        <p>Interactive examples that run in your browser, on a small dataset of chefs and recipes.</p>
        <ul>
          {
            examples.map(({ id, title, description }) => (
              <li>
                <a href={`/examples#${id}`}>
                  <strong>{title}</strong>
                  <span>{description}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="intro__aside">
    <div class="intro__packages">
      <h2>Packages</h2>
      <ul>
        <li>
          <code>@shapething/shacl-renderer</code>
          <span>React forms and views made from <Term id="shacl">SHACL</Term> shapes, plus TypeScript types and test data.</span>
        </li>
        <li>
          <code>@shapething/typed-sparql</code>
          <span>A Vite plugin that generates TypeScript types for the results of your <Term id="sparql">SPARQL</Term> queries.</span>
        </li>
        <li>
          <code>@shapething/resource-fetcher</code>
          <span>Fetches one complete <Term id="resource">resource</Term> from a store or a SPARQL endpoint, optionally guided by a shape.</span>
        </li>
        <li>
          <code>@shapething/textstore</code>
          <span>Fuzzy search on top of any <Term id="rdfjs">RDF/JS</Term> store, using plain SPARQL.</span>
        </li>
        <li>
          <code>@shapething/localstore</code>
          <span>Use a folder on your computer as a <Term id="triplestore">triplestore</Term>. Chrome only.</span>
        </li>
      </ul>
    </div>

    <aside class="intro__funding">
      <h2>Funding</h2>
      <p>
        The development of <code>@shapething/shacl-renderer</code> is funded through the
        <a href="https://nlnet.nl/commonsfund">NGI0 Commons Fund</a>, a fund established by
        <a href="https://nlnet.nl">NLnet</a> with financial support from the European Commission's
        <a href="https://ngi.eu">Next Generation Internet</a> program. The other packages are not part of this grant.
        Learn more at the <a href="https://nlnet.nl/project/ShapeThing">NLnet project page</a>.
      </p>
      <div class="intro__funding-logos">
        <a href="https://nlnet.nl"><img src="https://nlnet.nl/logo/banner.png" alt="NLnet foundation logo" /></a>
        <a href="https://nlnet.nl/commonsfund"><img src="https://nlnet.nl/image/logos/NGI0_tag.svg" alt="NGI Zero logo" /></a>
      </div>
    </aside>
    </div>
  </div>
</section>

<style>
  .intro {
    margin-block: 1em 0.5em;
  }

  .intro h1 {
    margin-block: 0.2em 0.3em;
    line-height: 1.05;
  }

  .intro__lead {
    max-width: 52em;
    font-size: 1.1em;
    line-height: 1.5;
  }

  .intro h2 {
    margin-block: 0 0.5em;
    font-size: 1.6em;
  }

  .intro__columns {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 1.5em 4em;
    align-items: start;
    margin-block: 1em 2em;
  }

  @media (max-width: 900px) {
    .intro__columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .intro__packages {
    padding: 1.2em 1.4em 0.6em;
    border: 1px solid var(--blue-lightest);
    border-radius: 6px;
  }

  .intro__aside {
    display: flex;
    flex-direction: column;
    gap: 2.5em;
  }

  .intro__funding {
    padding: 1.6em 1.8em;
    border: 1px solid var(--blue-lightest);
    border-radius: 6px;
    font-size: 16px;
    line-height: 1.45;
  }

  .intro__funding h2 {
    font-size: 1.3em;
  }

  .intro__funding p {
    margin-block: 0 1.4em;
  }

  .intro__funding-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5em;
  }

  .intro__funding-logos img {
    display: block;
    height: 28px;
    width: auto;
  }

  .intro ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 16px;
    line-height: 1.45;
  }

  .intro li {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.7em;
  }

  .intro code {
    font-weight: 600;
    color: var(--purple);
    overflow-wrap: anywhere;
  }

  .intro__examples {
    margin-top: 2em;
  }

  .intro__examples p {
    font-size: 16px;
  }

  .intro__examples ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1em;
  }

  .intro__examples li {
    margin: 0;
  }

  .intro__examples a {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
    height: 100%;
    padding: 1em;
    border: 1px solid var(--blue-lightest);
    border-radius: 6px;
    color: inherit;
    text-decoration: none;
  }

  .intro__examples a:hover,
  .intro__examples a:focus-visible {
    border-color: var(--purple);
  }

  .intro__examples strong {
    color: var(--blue-light);
  }
</style>
