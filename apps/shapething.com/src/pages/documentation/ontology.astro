---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'

const classes = await getCollection('classes')
const properties = await getCollection('properties')
---

<Layout>
  <h2>Classes</h2>
  {
    classes.map(classItem => {
      const localName = classItem.data.iri.split(/\#|\//g).pop()

      return (
        <div id={localName}>
          <h2>
            <a href={'#' + localName}>{classItem.data.label ?? localName}</a>
          </h2>
          <em>{localName}</em>
          <span>{classItem.data.description}</span>
        </div>
      )
    })
  }

  <h2>Properties</h2>
  {
    properties.map(property => {
      const localName = property.data.iri.split(/\#|\//g).pop()

      return (
        <div id={localName}>
          <h2>
            <a href={'#' + localName}>{property.data.label ?? localName}</a>
          </h2>
          <em>{localName}</em>
          <span>{property.data.description}</span>
        </div>
      )
    })
  }
</Layout>
