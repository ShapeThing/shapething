@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .

### A work, interest or idea in the lists of a person: its label is shown as a link.

inf:ItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "Name"@en ;
        shui:propertyRole shui:LabelRole ;
    ] .
