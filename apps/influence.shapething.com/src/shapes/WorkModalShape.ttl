@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

inf:WorkModalShape
    a sh:NodeShape ;
    rdfs:label "Work"@en ;
    sh:property inf:ModalImage, inf:ModalDescription, inf:ModalAbstract, inf:ModalWikipedia ;
    sh:property [
        sh:path wdt:P577 ;
        sh:name "Published"@en ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        shui:viewer inf:YearViewer ;
    ] .
