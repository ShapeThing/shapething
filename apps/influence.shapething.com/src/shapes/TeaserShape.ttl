@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix st: <http://shapething.com/> .

### Anything in a column or among the search results: a person, a band, a programming language.
### Only how it is shown: the properties with a role have no sh:path of their own, they get the
### paths of that role in every entity model (src/shapes/models, compiled in src/shapes/compile.ts).
### For the opened person of a column the introduction of their Wikipedia article and a link to the
### rest of it are added to the data (src/components/Column); nobody else has them.

inf:TeaserShape
    a sh:NodeShape ;
    rdfs:label "Teaser"@en ;
    sh:property [
        shui:propertyRole shui:DepictionRole ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 112 ; # shown at 56px in a column (--portrait-size)
        # The portrait opens the modal.
        st:href inf:aboutHref ;
        st:cssClass "portrait" ;
    ] ;
    sh:property [
        shui:propertyRole inf:StartRole ;
        sh:name "" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        shui:propertyRole inf:EndRole ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        shui:propertyRole shui:LabelRole ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        # The name opens it in the next column, or starts a chain with it: the link covers the
        # whole teaser (src/components/Column/style.scss).
        st:href inf:openHref ;
        st:cssClass "name" ;
    ] ;
    sh:property [
        sh:path inf:influenceCount ;
        sh:name "" ;
        sh:description "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer inf:RelativeInfluenceViewer ;
        st:cssClass "influence" ;
    ] ;
    sh:property [
        shui:propertyRole shui:DescriptionRole ;
        sh:name "" ;
        sh:order 5 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        st:cssClass "description" ;
    ] ;
    sh:property [
        sh:path schema:abstract ;
        sh:name "" ;
        sh:order 6 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        # The opening lines only: the whole of it is in the modal.
        st:cssClass "abstract" ;
    ] ;
    sh:property [
        sh:path inf:viewMore ;
        sh:name "" ;
        sh:description "" ;
        sh:order 7 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        # The rest of the introduction, and everything else, is in the modal.
        st:href inf:aboutHref ;
        st:cssClass "view-more" ;
    ] .
