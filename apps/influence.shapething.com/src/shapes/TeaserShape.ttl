@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix st: <http://shapething.com/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

### A search result: the portrait, the name, the years, the description and the relative
### influence among the results.

inf:TeaserShape
    a sh:NodeShape ;
    rdfs:label "Person teaser"@en ;
    sh:property [
        sh:path wdt:P18 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 72 ; # shown at 36px (--teaser-portrait)
        shui:propertyRole shui:DepictionRole ;
        st:cssClass "portrait" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        # Before inf:lifespan, which has sh:order 1.
        sh:order 0.5 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:LabelRole ;
        # The name starts a chain with the person (the whole result is the link, see Teaser).
        st:href inf:openHref ;
        st:cssClass "name" ;
    ] ;
    sh:property [
        sh:path wdt:P569 ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path wdt:P570 ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:name "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:DescriptionRole ;
        st:cssClass "description" ;
    ] .
