@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix st: <http://shapething.com/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### The display shapes of the app. They render the data graphs of src/data/graphs.ts: Wikidata
### triples with Wikidata's own predicates, plus inf:influenceCount and schema:abstract.
###
### Every property declares its shui:viewer, so no widget scoring is needed. The three custom
### viewers are registered in src/widgets/index.ts.
###
### Most values speak for themselves and have no label: an empty sh:name leaves the header of the
### field empty, and the view mode hides an empty header. Only the item lists and the facts of the
### modal (and the Wikipedia link) have a label. An empty sh:description keeps the help icon of
### inf:influenceCount's rdfs:comment out of a header that has no label.

inf:fullName
    a rdf:Property ;
    rdfs:label "Full name"@en ;
    rdfs:comment "The full name of a person: their name in their own language (P1559, name in native language), or else their name."@en .

inf:influenceCount
    a rdf:Property ;
    rdfs:label "Influence"@en ;
    rdfs:comment "How many people this person influenced, according to Wikidata (P737, influenced by)."@en ;
    rdfs:range xsd:integer .

inf:RelativeInfluenceViewer
    a shui:Widget ;
    rdfs:label "Relative influence"@en ;
    rdfs:comment "A bar showing an influence count relative to the people shown in the app at the moment."@en .

inf:PortraitViewer
    a shui:Widget ;
    rdfs:label "Portrait"@en ;
    rdfs:comment "The portrait of a person, or their initials (the sh:defaultValue inf:Initials) when there is none."@en .

### Not a real image: the default portrait, which inf:PortraitViewer shows as the person's
### initials. The display shapes are only rendered in view mode, so it is never written to data.
inf:Initials
    a rdfs:Resource ;
    rdfs:label "Initials"@en .

inf:YearViewer
    a shui:Widget ;
    rdfs:label "Year"@en ;
    rdfs:comment "The year of a Wikidata date, with BCE for the years before the common era."@en .

inf:EntityLinkViewer
    a shui:Widget ;
    rdfs:label "Link to the entity"@en ;
    rdfs:comment "A name as a link to the resource it belongs to, which opens it in the modal."@en .

### Groups. They have no label, they bring together what is laid out together (see src/styles).

inf:lifespan a sh:PropertyGroup ; sh:order 1 .
inf:itemLists a sh:PropertyGroup ; sh:order 10 .
inf:facts a sh:PropertyGroup ; sh:order 2 .
inf:text a sh:PropertyGroup ; sh:order 3 .

### One person in a column: the portrait, the years, the name and the relative influence, and
### for the person that is opened their works, interests and ideas below. Those arrive later: they
### are added to the person's live data graph (src/components/PersonRow), so the rest stays as it
### is and the portrait is loaded once.

inf:ColumnShape
    a sh:NodeShape ;
    rdfs:label "Person in a column"@en ;
    sh:property [
        sh:path wdt:P18 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 112 ; # shown at 56px (--portrait-size)
        shui:propertyRole shui:DepictionRole ;
    ] ;
    sh:property [
        sh:path wdt:P569 ;
        sh:name "" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path wdt:P570 ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path inf:influenceCount ;
        sh:name "" ;
        sh:description "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer inf:RelativeInfluenceViewer ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath wdt:P50 ] ;
        sh:name "Works"@en ;
        sh:order 5 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        st:orderBy wdt:P577 ;
        shui:viewer shui:LabelViewer ;
    ] ;
    sh:property [
        sh:path wdt:P101 ;
        sh:name "Interests"@en ;
        sh:order 6 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        shui:viewer shui:LabelViewer ;
    ] ;
    sh:property [
        sh:path wdt:P800 ;
        sh:name "Ideas"@en ;
        sh:order 7 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        shui:viewer shui:LabelViewer ;
    ] .

### A work, interest or idea in the lists of a person: its label is shown as a link.

inf:ItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "Name"@en ;
        shui:propertyRole shui:LabelRole ;
    ] .

### A search result: the portrait, the name, the years, the description and the relative
### influence among the results.

inf:TeaserShape
    a sh:NodeShape ;
    rdfs:label "Person teaser"@en ;
    sh:property [
        sh:path wdt:P18 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 96 ; # shown at 48px (--teaser-portrait)
        shui:propertyRole shui:DepictionRole ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        # Before inf:lifespan, which has sh:order 1.
        sh:order 0.5 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path wdt:P569 ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path wdt:P570 ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:name "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:DescriptionRole ;
    ] ;
    sh:property [
        sh:path inf:influenceCount ;
        sh:name "" ;
        sh:description "" ;
        sh:order 5 ;
        sh:maxCount 1 ;
        shui:viewer inf:RelativeInfluenceViewer ;
    ] .

### The modal: everything about a person, a work, or a concept (an interest or an idea). The kind is
### judged from the entity itself (src/data/person.ts). The name is the title of the modal itself,
### not a property.
###
### The modal has two columns (src/components/EntityModal). The side column, which stays in view
### while the rest scrolls, has the image and the facts: each kind has its own shape for it, as
### only a person has a lifespan and an influence, only a work a publication date. The main column
### has the text, which is the same for every kind (inf:ModalTextShape), and below it every property.

inf:PersonModalShape
    a sh:NodeShape ;
    rdfs:label "Person"@en ;
    sh:property inf:ModalImage ;
    sh:property [
        sh:path inf:fullName ;
        sh:name "" ;
        sh:description "" ;
        sh:order 0.5 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
    ] ;
    sh:property [
        sh:path wdt:P569 ;
        sh:name "Born"@en ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path wdt:P570 ;
        sh:name "Died"@en ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path inf:influenceCount ;
        sh:name "Influence"@en ;
        # First of the facts, directly below the name.
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        shui:viewer inf:RelativeInfluenceViewer ;
    ] ;
    # The countries of citizenship, each with its flag and name (inf:CountryShape).
    sh:property [
        sh:path wdt:P27 ;
        sh:name "Citizenship"@en ;
        sh:order 2.5 ;
        sh:group inf:facts ;
        sh:node inf:CountryShape ;
        shui:viewer shui:DetailsViewer ;
    ] ;
    # The occupations: their names as links, which open them in the modal.
    sh:property [
        sh:path wdt:P106 ;
        sh:name "Occupation"@en ;
        # Below the map of the place of birth.
        sh:order 5 ;
        sh:group inf:facts ;
        sh:node inf:ItemShape ;
        shui:viewer shui:LabelViewer ;
    ] ;
    # The place itself, not its coordinates: st:MapViewer walks one hop into it (inf:PlaceShape)
    # for the coordinates and for the name it shows when the marker is hovered.
    sh:property [
        sh:path wdt:P19 ;
        sh:name "Place of birth"@en ;
        sh:order 4 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        sh:node inf:PlaceShape ;
        shui:viewer st:MapViewer ;
        st:mapMaxZoom 5 ;
    ] .

### A country of citizenship: its flag (P41), then its name, as a link to the country.

inf:CountryShape
    a sh:NodeShape ;
    sh:property [
        sh:path wdt:P41 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        shui:viewer shui:ImageViewer ;
        st:imageWidth 64 ; # shown 16px high (EntityModal/style.scss)
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        # A link that opens the country in the modal.
        shui:viewer inf:EntityLinkViewer ;
        shui:propertyRole shui:LabelRole ;
    ] .

### A place on a map: its coordinates (P625, a WKT point) and its name.

inf:PlaceShape
    a sh:NodeShape ;
    sh:property [
        sh:path wdt:P625 ;
        shui:propertyRole st:GeoRole ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        shui:propertyRole shui:LabelRole ;
    ] .

inf:WorkModalShape
    a sh:NodeShape ;
    rdfs:label "Work"@en ;
    sh:property inf:ModalImage ;
    sh:property [
        sh:path wdt:P577 ;
        sh:name "Published"@en ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        shui:viewer inf:YearViewer ;
    ] .

inf:ConceptModalShape
    a sh:NodeShape ;
    rdfs:label "Concept"@en ;
    sh:property inf:ModalImage .

inf:ModalTextShape
    a sh:NodeShape ;
    rdfs:label "Text"@en ;
    sh:property inf:ModalDescription, inf:ModalAbstract, inf:ModalWikipedia .

inf:ModalImage
    a sh:PropertyShape ;
    sh:path wdt:P18 ;
    sh:name "" ;
    sh:order 0 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    shui:viewer shui:ImageViewer ;
    st:imageWidth 500 ;
    shui:propertyRole shui:DepictionRole .

inf:ModalDescription
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:name "" ;
    sh:order 5 ;
    sh:maxCount 1 ;
    sh:group inf:text ;
    shui:viewer shui:LiteralViewer ;
    shui:propertyRole shui:DescriptionRole .

inf:ModalAbstract
    a sh:PropertyShape ;
    sh:path schema:abstract ;
    sh:name "" ;
    sh:order 6 ;
    sh:maxCount 1 ;
    sh:group inf:text ;
    shui:viewer shui:LiteralViewer .

inf:ModalWikipedia
    a sh:PropertyShape ;
    sh:path [ sh:inversePath schema:about ] ;
    sh:name "Wikipedia"@en ;
    sh:order 7 ;
    sh:maxCount 1 ;
    sh:group inf:text ;
    shui:viewer shui:HyperlinkViewer .

### Every property of the entity in the modal, below the rest: a second renderer. The property
### shapes are made for each entity from what Wikidata states about it (src/data/resource.ts),
### the external identifiers in a group of their own. Unlike the groups above, these have a label.

inf:AllPropertiesShape
    a sh:NodeShape ;
    rdfs:label "All properties"@en .

inf:statements a sh:PropertyGroup ; rdfs:label "Information"@en ; sh:order 20 .
# The external identifiers are many (hundreds for a well-known person) and rarely read: a group
# that starts closed.
inf:identifiers
    a sh:PropertyGroup, st:CollapsiblePropertyGroup ;
    rdfs:label "Identifiers"@en ;
    sh:order 21 ;
    st:collapsed true .
