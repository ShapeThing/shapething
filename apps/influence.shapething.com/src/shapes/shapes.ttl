@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix st: <http://shapething.com/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### The display shapes of the app. They render the data graphs of src/data/graphs.ts: Wikidata
### triples with Wikidata's own predicates, plus inf:influenceCount and schema:abstract.
###
### Every property declares its shui:viewer, so no widget scoring is needed. The custom viewers
### are registered in src/widgets/index.ts.
###
### The stylesheets lay the shapes out by the names st:cssClass gives a property or a group, not by
### the structure the renderer produces. The links of the app are in the data (src/data/graphs.ts):
### st:href makes a name a link to inf:openHref, a portrait one to inf:aboutHref.
###
### Most values speak for themselves and have no label: an empty sh:name leaves the header of the
### field empty, and the view mode hides an empty header. Only the item lists and the facts of the
### modal (and the Wikipedia link) have a label. An empty sh:description keeps the help icon of
### inf:influenceCount's rdfs:comment out of a header that has no label.

inf:openHref
    a rdf:Property ;
    rdfs:label "Open"@en ;
    rdfs:comment "Where a person leads: the path of the app that starts a chain with them."@en .

inf:aboutHref
    a rdf:Property ;
    rdfs:label "About"@en ;
    rdfs:comment "Where more about an entity is: the hash of the app that opens it in the modal."@en .

inf:fullName
    a rdf:Property ;
    rdfs:label "Full name"@en ;
    rdfs:comment "The full name of a person: their name in their own language (P1559, name in native language), or else their name."@en .

inf:influenceCount
    a rdf:Property ;
    rdfs:label "Influence"@en ;
    rdfs:comment "How many people this person influenced, according to Wikidata (P737, influenced by)."@en ;
    rdfs:range xsd:integer .

inf:RelativeInfluenceViewer
    a shui:Widget ;
    rdfs:label "Relative influence"@en ;
    rdfs:comment "A bar showing an influence count relative to the people shown in the app at the moment."@en .

inf:PortraitViewer
    a shui:Widget ;
    rdfs:label "Portrait"@en ;
    rdfs:comment "The portrait of a person, or their initials (the sh:defaultValue inf:Initials) when there is none."@en .

### Not a real image: the default portrait, which inf:PortraitViewer shows as the person's
### initials. The display shapes are only rendered in view mode, so it is never written to data.
inf:Initials
    a rdfs:Resource ;
    rdfs:label "Initials"@en .

inf:YearViewer
    a shui:Widget ;
    rdfs:label "Year"@en ;
    rdfs:comment "The year of a Wikidata date, with BCE for the years before the common era."@en .

inf:EntityLinkViewer
    a shui:Widget ;
    rdfs:label "Link to the entity"@en ;
    rdfs:comment "A name as a link to the resource it belongs to, which opens it in the modal."@en .

### Groups. They have no label, they bring together what is laid out together.

inf:lifespan a sh:PropertyGroup ; sh:order 1 ; st:cssClass "lifespan" .
inf:itemLists a sh:PropertyGroup ; sh:order 10 ; st:cssClass "item-lists" .

# The two columns of the modal: the side column (the image and the facts) and the main one (the
# text). Within them, nested groups.
inf:side a sh:PropertyGroup ; sh:order 0 ; st:cssClass "entity-modal__side" .
inf:main a sh:PropertyGroup ; sh:order 1 ; st:cssClass "entity-modal__main" .
# The short description in the side column, between the name and the facts.
inf:summary a sh:PropertyGroup ; sh:group inf:side ; sh:order 1.5 ; st:cssClass "summary" .
inf:facts a sh:PropertyGroup ; sh:group inf:side ; sh:order 2 ; st:cssClass "facts" .
inf:text a sh:PropertyGroup ; sh:group inf:main ; sh:order 3 ; st:cssClass "text" .

### One person in a column: the portrait, the years, the name and the relative influence, and
### for the person that is opened their works, interests and ideas below. Those arrive later: they
### are added to the person's live data graph (src/components/PersonRow), so the rest stays as it
### is and the portrait is loaded once.

inf:ColumnShape
    a sh:NodeShape ;
    rdfs:label "Person in a column"@en ;
    sh:property [
        sh:path wdt:P18 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 112 ; # shown at 56px (--portrait-size)
        shui:propertyRole shui:DepictionRole ;
        # The portrait opens the modal.
        st:href inf:aboutHref ;
        st:cssClass "portrait" ;
    ] ;
    sh:property [
        sh:path wdt:P569 ;
        sh:name "" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path wdt:P570 ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:LabelRole ;
        # The name opens the person in the next column (the whole row is the link, see PersonRow).
        st:href inf:openHref ;
        st:cssClass "name" ;
    ] ;
    sh:property [
        sh:path inf:influenceCount ;
        sh:name "" ;
        sh:description "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer inf:RelativeInfluenceViewer ;
        st:cssClass "influence" ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath wdt:P50 ] ;
        sh:name "Works"@en ;
        sh:order 5 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        st:orderBy wdt:P577 ;
        shui:viewer shui:LabelViewer ;
    ] ;
    sh:property [
        sh:path wdt:P101 ;
        sh:name "Interests"@en ;
        sh:order 6 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        shui:viewer shui:LabelViewer ;
    ] ;
    sh:property [
        sh:path wdt:P800 ;
        sh:name "Ideas"@en ;
        sh:order 7 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        shui:viewer shui:LabelViewer ;
    ] .

### A work, interest or idea in the lists of a person: its label is shown as a link.

inf:ItemShape
    a sh:NodeShape ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "Name"@en ;
        shui:propertyRole shui:LabelRole ;
    ] .

### A search result: the portrait, the name, the years, the description and the relative
### influence among the results.

inf:TeaserShape
    a sh:NodeShape ;
    rdfs:label "Person teaser"@en ;
    sh:property [
        sh:path wdt:P18 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 72 ; # shown at 36px (--teaser-portrait)
        shui:propertyRole shui:DepictionRole ;
        st:cssClass "portrait" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        # Before inf:lifespan, which has sh:order 1.
        sh:order 0.5 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:LabelRole ;
        # The name starts a chain with the person (the whole result is the link, see Teaser).
        st:href inf:openHref ;
        st:cssClass "name" ;
    ] ;
    sh:property [
        sh:path wdt:P569 ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path wdt:P570 ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:name "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:DescriptionRole ;
        st:cssClass "description" ;
    ] .

### The modal: everything about a person, a work, or a concept (an interest or an idea). The kind is
### judged from the entity itself (src/data/person.ts). The name is the title of the modal itself,
### not a property.
###
### The modal has two columns, the groups inf:side and inf:main (laid out by
### src/components/EntityModal). The side column, which stays in view while the rest scrolls, has
### the image, the short description and the facts: each kind has its own shape, as only a person
### has a lifespan and an influence, only a work a publication date. The main column has the text,
### the same for every kind, and below it (a second renderer) every property.

inf:PersonModalShape
    a sh:NodeShape ;
    rdfs:label "Person"@en ;
    sh:property inf:ModalImage, inf:ModalSummary, inf:ModalAbstract, inf:ModalWikipedia ;

    sh:property [
        sh:path inf:influenceCount ;
        sh:name "Influence"@en ;
        # First of the facts, directly below the name.
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        shui:viewer inf:RelativeInfluenceViewer ;
        st:cssClass "influence" ;
    ] ;
.
### A country of citizenship: its flag (P41), then its name, as a link to the country.

inf:CountryShape
    a sh:NodeShape ;
    sh:property [
        sh:path wdt:P41 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        shui:viewer shui:ImageViewer ;
        st:imageWidth 64 ; # shown 16px high (EntityModal/style.scss)
        st:cssClass "flag" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        # A link that opens the country in the modal.
        shui:viewer inf:EntityLinkViewer ;
        shui:propertyRole shui:LabelRole ;
    ] .

### A place on a map: its coordinates (P625, a WKT point) and its name.

inf:PlaceShape
    a sh:NodeShape ;
    sh:property [
        sh:path wdt:P625 ;
        shui:propertyRole st:GeoRole ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        shui:propertyRole shui:LabelRole ;
    ] .

inf:WorkModalShape
    a sh:NodeShape ;
    rdfs:label "Work"@en ;
    sh:property inf:ModalImage, inf:ModalDescription, inf:ModalAbstract, inf:ModalWikipedia ;
    sh:property [
        sh:path wdt:P577 ;
        sh:name "Published"@en ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:facts ;
        shui:viewer inf:YearViewer ;
    ] .

inf:ConceptModalShape
    a sh:NodeShape ;
    rdfs:label "Concept"@en ;
    sh:property inf:ModalImage, inf:ModalDescription, inf:ModalAbstract, inf:ModalWikipedia .

inf:ModalImage
    a sh:PropertyShape ;
    sh:path wdt:P18 ;
    sh:name "" ;
    sh:order 0 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    shui:viewer shui:ImageViewer ;
    st:imageWidth 500 ;
    shui:propertyRole shui:DepictionRole ;
    sh:group inf:side ;
    st:cssClass "image" .

# The short description ("country in South America"): in the side column, below the image and the
# name, not above the text, which it would only repeat in brief.
inf:ModalDescription
    a sh:PropertyShape ;
    sh:path schema:description ;
    sh:name "" ;
    sh:order 0 ;
    sh:maxCount 1 ;
    sh:group inf:summary ;
    shui:viewer shui:LiteralViewer ;
    shui:propertyRole shui:DescriptionRole .

# A person's short description, composed from the data rather than taken from Wikidata's
# hand-written schema:description, so every person reads the same way: "Danish theologian,
# philosopher, poet and social critic (1813–1855)". st:mergeAlternatives shows one value composed
# from every branch: the demonyms of the countries of citizenship, the occupations (by their
# names), and the years of birth and death. The years are left out, brackets and all, when
# neither is known; the demonym is only there when src/data/person.ts could tell which one is the
# adjective.
inf:ModalSummary
    a sh:PropertyShape ;
    sh:path [ sh:alternativePath (
        ( wdt:P27 wdt:P1549 ) # {0} demonym, "Danish"
        wdt:P106 # {1} occupations
        wdt:P569 # {2} date of birth
        wdt:P570 # {3} date of death
    ) ] ;
    st:mergeAlternatives true ;
    st:mergeTemplate "{0} {1}[ ({2:year}–{3:year})]" ;
    sh:name "" ;
    sh:order 0 ;
    sh:maxCount 1 ;
    sh:group inf:summary ;
    shui:viewer shui:LiteralViewer ;
    shui:propertyRole shui:DescriptionRole .


inf:ModalAbstract
    a sh:PropertyShape ;
    sh:path schema:abstract ;
    sh:name "" ;
    sh:order 6 ;
    sh:maxCount 1 ;
    sh:group inf:text ;
    shui:viewer shui:LiteralViewer ;
    st:cssClass "abstract" .

inf:ModalWikipedia
    a sh:PropertyShape ;
    sh:path [ sh:inversePath schema:about ] ;
    sh:name "Wikipedia"@en ;
    sh:order 7 ;
    sh:maxCount 1 ;
    sh:group inf:text ;
    shui:viewer shui:HyperlinkViewer ;
    st:cssClass "wikipedia" .

### Every property of a person in the modal, below the rest: a second renderer. Its data is what
### Wikidata states about the person, with an rdf:type for each instance of (P31) (see
### src/queries/allProperties.rq). This shape targets the people (wd:Q5, human), and the renderer's
### enableMissingShapesGeneration gives it a property for every predicate of theirs that it does
### not ignore. The app puts each of those in a group (src/shapes/groupProperties.ts): the external
### identifiers in one of their own. Unlike the groups above, these have a label.

inf:statements a sh:PropertyGroup ; rdfs:label "Information"@en ; sh:order 20 .
# The external identifiers are many (hundreds for a well-known person) and rarely read: a group
# that starts closed.
inf:identifiers
    a sh:PropertyGroup, st:CollapsiblePropertyGroup ;
    rdfs:label "Identifiers"@en ;
    sh:order 21 ;
    st:collapsed true .

inf:AllPropertiesShape
    a sh:NodeShape ;
    rdfs:label "All properties"@en ;
    sh:targetClass wd:Q5 ;
    # What inf:PersonModalShape already shows, so nothing is shown twice. Also the type itself,
    # the full name (P1559, already inf:fullName), the page banner (P948, the banner of the
    # modal, see src/components/Modal), and the coordinates beside the coordinate location (P625)
    # - the extreme points, the geographic center, the place depicted, the sandbox - which would
    # each be one more map.
    sh:ignoredProperties (
        rdf:type
        wdt:P18 # image
        wdt:P569 # date of birth
        wdt:P570 # date of death
        wdt:P27 # country of citizenship
        wdt:P106 # occupation
        wdt:P19 # place of birth
        wdt:P1559 # name in native language
        wdt:P948 # page banner
        wdt:P1332 # coordinates of northernmost point
        wdt:P1333 # coordinates of southernmost point
        wdt:P1334 # coordinates of easternmost point
        wdt:P1335 # coordinates of westernmost point
        wdt:P5140 # coordinates of geographic center
        wdt:P9149 # coordinates of depicted place
        wdt:P626 # Sandbox-Geographic coordinates
    ) .
