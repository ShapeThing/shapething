@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### The vocabulary of the app: its own properties, the custom viewers (registered in
### src/widgets/index.ts), and inf:Initials, the default portrait.

inf:openHref
    a rdf:Property ;
    rdfs:label "Open"@en ;
    rdfs:comment "Where a person leads: the path of the app that starts a chain with them."@en .

inf:aboutHref
    a rdf:Property ;
    rdfs:label "About"@en ;
    rdfs:comment "Where more about an entity is: the hash of the app that opens it in the modal."@en .

inf:viewMore
    a rdf:Property ;
    rdfs:label "View more"@en ;
    rdfs:comment "The text of the link from the introduction of an opened person in a column to the modal, where the rest of it is."@en .

inf:influenceCount
    a rdf:Property ;
    rdfs:label "Influence"@en ;
    rdfs:comment "How many people this person influenced, according to Wikidata (P737, influenced by)."@en ;
    rdfs:range xsd:integer .

inf:RelativeInfluenceViewer
    a shui:Widget ;
    rdfs:label "Relative influence"@en ;
    rdfs:comment "A bar showing an influence count relative to the people shown in the app at the moment."@en .

inf:PortraitViewer
    a shui:Widget ;
    rdfs:label "Portrait"@en ;
    rdfs:comment "The portrait of a person, or their initials (the sh:defaultValue inf:Initials) when there is none."@en .

### Not a real image: the default portrait, which inf:PortraitViewer shows as the person's
### initials. The display shapes are only rendered in view mode, so it is never written to data.
inf:Initials
    a rdfs:Resource ;
    rdfs:label "Initials"@en .

inf:YearViewer
    a shui:Widget ;
    rdfs:label "Year"@en ;
    rdfs:comment "The year of a Wikidata date, with BCE for the years before the common era."@en .

inf:EntityLinkViewer
    a shui:Widget ;
    rdfs:label "Link to the entity"@en ;
    rdfs:comment "A name as a link to the resource it belongs to, which opens it in the modal."@en .

inf:worksEvent
    a rdf:Property ;
    rdfs:label "Life event"@en ;
    rdfs:comment "The birth or the death of someone who made works, with its date (P585, point in time): a row of the timeline of their works. inf:albumsEvent and inf:artworksEvent are the same for the timelines of their albums and artworks."@en .

inf:albumsEvent a rdf:Property ; rdfs:label "Life event"@en .
inf:artworksEvent a rdf:Property ; rdfs:label "Life event"@en .

inf:cover
    a rdf:Property ;
    rdfs:label "Cover"@en ;
    rdfs:comment "The cover of a book (Open Library) or an album (the Cover Art Archive), by the identifier Wikidata has of it: a URL only, the image may not exist."@en .

inf:EntityModel
    a rdfs:Class ;
    rdfs:label "Entity model"@en ;
    rdfs:comment "A node shape that says what the data of a kind of thing is (src/shapes/models): its property shapes' roles give the display shapes their paths (src/shapes/compile.ts)."@en .

inf:eventLabel
    a rdf:Property ;
    rdfs:label "Event"@en ;
    rdfs:comment "What a life event is: \"Born\" or \"Died\"."@en .

inf:StartRole
    a shui:PropertyRole ;
    rdfs:label "Start"@en ;
    rdfs:comment "The role of the property that says when something started: a person's birth, a band's forming. Display shapes take its paths from the entity models (src/shapes/compile.ts)."@en .

inf:EndRole
    a shui:PropertyRole ;
    rdfs:label "End"@en ;
    rdfs:comment "The role of the property that says when something ended: a person's death, a band's breaking up."@en .

inf:orderByRole
    a rdf:Property ;
    rdfs:label "Order by role"@en ;
    rdfs:comment "On a property shape: its values are ordered (st:orderBy) by the paths the entity models give this role (src/shapes/compile.ts)."@en .

inf:result
    a rdf:Property ;
    rdfs:label "Result"@en ;
    rdfs:comment "A result of a search: from the result node of the search query to what it found."@en .
