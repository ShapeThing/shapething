@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix st: <http://shapething.com/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

### One person in a column: the portrait, the years, the name and the relative influence, and
### for the person that is opened the introduction of their Wikipedia article below. That arrives
### later: it is added to the person's live data graph (src/components/PersonRow), so the rest stays
### as it is and the portrait is loaded once. What they made, their ideas and their interests are in
### the modal (src/components/EntityLists).

inf:ColumnShape
    a sh:NodeShape ;
    rdfs:label "Person in a column"@en ;
    sh:property [
        sh:path wdt:P18 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 112 ; # shown at 56px (--portrait-size)
        shui:propertyRole shui:DepictionRole ;
        # The portrait opens the modal.
        st:href inf:aboutHref ;
        st:cssClass "portrait" ;
    ] ;
    sh:property [
        # Born, or (a band) formed.
        sh:path [ sh:alternativePath ( wdt:P569 wdt:P571 ) ] ;
        sh:name "" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        # Died, or (a band) broke up.
        sh:path [ sh:alternativePath ( wdt:P570 wdt:P576 ) ] ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:LabelRole ;
        # The name opens the person in the next column (the whole row is the link, see PersonRow).
        st:href inf:openHref ;
        st:cssClass "name" ;
    ] ;
    sh:property [
        sh:path inf:influenceCount ;
        sh:name "" ;
        sh:description "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer inf:RelativeInfluenceViewer ;
        st:cssClass "influence" ;
    ] ;
    sh:property [
        sh:path schema:abstract ;
        sh:name "" ;
        sh:order 5 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        # The opening lines only (PersonRow/style.scss): the whole of it is in the modal.
        st:cssClass "abstract" ;
    ] ;
    sh:property [
        sh:path inf:viewMore ;
        sh:name "" ;
        sh:description "" ;
        sh:order 6 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        # The rest of the introduction, and everything else, is in the modal.
        st:href inf:aboutHref ;
        st:cssClass "view-more" ;
    ] .
