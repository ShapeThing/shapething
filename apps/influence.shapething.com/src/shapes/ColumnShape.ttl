@prefix inf: <https://influence.shapething.com/ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix st: <http://shapething.com/> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .

### One person in a column: the portrait, the years, the name and the relative influence, and
### for the person that is opened their works, interests and ideas below. Those arrive later: they
### are added to the person's live data graph (src/components/PersonRow), so the rest stays as it
### is and the portrait is loaded once.

inf:ColumnShape
    a sh:NodeShape ;
    rdfs:label "Person in a column"@en ;
    sh:property [
        sh:path wdt:P18 ;
        sh:name "" ;
        sh:order 0 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        shui:viewer inf:PortraitViewer ;
        sh:defaultValue inf:Initials ;
        st:imageWidth 112 ; # shown at 56px (--portrait-size)
        shui:propertyRole shui:DepictionRole ;
        # The portrait opens the modal.
        st:href inf:aboutHref ;
        st:cssClass "portrait" ;
    ] ;
    sh:property [
        sh:path wdt:P569 ;
        sh:name "" ;
        sh:order 1 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path wdt:P570 ;
        sh:name "" ;
        sh:order 2 ;
        sh:maxCount 1 ;
        sh:group inf:lifespan ;
        shui:viewer inf:YearViewer ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:name "" ;
        sh:order 3 ;
        sh:maxCount 1 ;
        shui:viewer shui:LiteralViewer ;
        shui:propertyRole shui:LabelRole ;
        # The name opens the person in the next column (the whole row is the link, see PersonRow).
        st:href inf:openHref ;
        st:cssClass "name" ;
    ] ;
    sh:property [
        sh:path inf:influenceCount ;
        sh:name "" ;
        sh:description "" ;
        sh:order 4 ;
        sh:maxCount 1 ;
        shui:viewer inf:RelativeInfluenceViewer ;
        st:cssClass "influence" ;
    ] ;
    sh:property [
        sh:path [ sh:inversePath wdt:P50 ] ;
        sh:name "Works"@en ;
        sh:order 7 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        # By the year they were made (P571 inception), or else published (P577).
        st:orderBy [ sh:alternativePath ( wdt:P571 wdt:P577 ) ] ;
        shui:viewer shui:LabelViewer ;
    ] ;
    sh:property [
        sh:path wdt:P101 ;
        sh:name "Interests"@en ;
        sh:order 6 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        shui:viewer shui:LabelViewer ;
    ] ;
    sh:property [
        sh:path wdt:P800 ;
        sh:name "Ideas"@en ;
        sh:order 5 ;
        sh:group inf:itemLists ;
        sh:node inf:ItemShape ;
        shui:viewer shui:LabelViewer ;
    ] .
