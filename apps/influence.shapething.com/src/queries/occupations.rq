PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# The occupations (P106) of $entity with their names, for the side column of the modal. Only the
# ones with an English or "mul" name: there is nothing readable to show of the others.
SELECT ?occupation ?name ?mulName WHERE {
  $entity wdt:P106 ?occupation .
  FILTER(isIRI(?occupation))
  OPTIONAL { ?occupation rdfs:label ?name . FILTER(LANG(?name) = "en") }
  OPTIONAL { ?occupation rdfs:label ?mulName . FILTER(LANG(?mulName) = "mul") }
  FILTER(BOUND(?name) || BOUND(?mulName))
}
