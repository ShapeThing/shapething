PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <http://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# Everything shown about one entity: a person, but also a work, an interest or an idea.
SELECT ?name ?mulName ?fullName ?description ?image ?banner ?birthDate ?deathDate ?inception ?dissolved ?birthPlace ?birthPlaceName ?birthPlaceLocation ?citizenship ?citizenshipName ?flag ?demonym ?demonymIsAdjective ?publicationDate ?openLibraryId ?authorName ?article ?isPerson ?hasAuthor ?isBook (xsd:integer(?count) AS ?influence) WHERE {
  { SELECT (COUNT(DISTINCT ?influenced) AS ?count) WHERE { ?influenced wdt:P737 $entity } }
  # A person: a human (Q5), or a band (an instance of Q215380 musical group, or of a kind of it),
  # which has works, influences and a chain of its own like a person.
  BIND(EXISTS { $entity wdt:P31 wd:Q5 } || EXISTS { $entity wdt:P31/wdt:P279* wd:Q215380 } AS ?isPerson)
  BIND(EXISTS { $entity wdt:P50 [] } AS ?hasAuthor)
  OPTIONAL { $entity rdfs:label ?name . FILTER(LANG(?name) = "en") }
  OPTIONAL { $entity rdfs:label ?mulName . FILTER(LANG(?mulName) = "mul") }
  OPTIONAL { $entity schema:description ?description . FILTER(LANG(?description) = "en") }
  # The full name, in the person's own language (P1559, name in native language).
  OPTIONAL { $entity wdt:P1559 ?fullName . FILTER(isLiteral(?fullName)) }
  OPTIONAL { $entity wdt:P18 ?image . FILTER(isIRI(?image)) }
  # The page banner (P948, a wide Commons image made for Wikivoyage), across the top of the modal.
  OPTIONAL { $entity wdt:P948 ?banner . FILTER(isIRI(?banner)) }
  OPTIONAL { $entity wdt:P569 ?birthDate . FILTER(isLiteral(?birthDate)) }
  OPTIONAL { $entity wdt:P570 ?deathDate . FILTER(isLiteral(?deathDate)) }
  # A band's dates: when it was formed (P571, inception) and when it broke up (P576, dissolved).
  OPTIONAL { $entity wdt:P571 ?inception . FILTER(isLiteral(?inception)) }
  OPTIONAL { $entity wdt:P576 ?dissolved . FILTER(isLiteral(?dissolved)) }
  # The place of birth, for the map in the modal: only one with coordinates (P625) can be shown.
  OPTIONAL {
    $entity wdt:P19 ?birthPlace .
    ?birthPlace wdt:P625 ?birthPlaceLocation .
    FILTER(isIRI(?birthPlace) && isLiteral(?birthPlaceLocation))
    OPTIONAL { ?birthPlace rdfs:label ?birthPlaceName . FILTER(LANG(?birthPlaceName) = "en") }
  }
  # The countries of citizenship, for their flags (P41) in the modal.
  OPTIONAL {
    $entity wdt:P27 ?citizenship .
    ?citizenship wdt:P41 ?flag .
    FILTER(isIRI(?citizenship) && isIRI(?flag))
    OPTIONAL { ?citizenship rdfs:label ?citizenshipName . FILTER(LANG(?citizenshipName) = "en") }
    # The English demonyms (P1549) of the country, for the summary of a person ("Danish"). A
    # country often has a noun too ("Dane"): the adjective is qualified "applies to part"
    # (P518) adjective (Q34698).
    OPTIONAL {
      ?citizenship p:P1549 ?demonymStatement .
      ?demonymStatement ps:P1549 ?demonym .
      FILTER(LANG(?demonym) = "en")
      FILTER NOT EXISTS { ?demonymStatement wikibase:rank wikibase:DeprecatedRank }
      BIND(EXISTS { ?demonymStatement pq:P518 wd:Q34698 } AS ?demonymIsAdjective)
    }
  }
  OPTIONAL { $entity wdt:P577 ?publicationDate . FILTER(isLiteral(?publicationDate)) }
  # A book (data/openLibrary.ts prefers its Open Library cover to its image): one Open Library
  # knows (P648), or an instance (P31) of a kind of book.
  BIND((EXISTS { $entity wdt:P648 [] } || EXISTS {
    VALUES ?bookType { wd:Q571 wd:Q7725634 wd:Q47461344 wd:Q8261 wd:Q5185279 wd:Q35760 wd:Q25379 wd:Q49084 }
    $entity wdt:P31 ?bookType
  }) AS ?isBook)
  # For the cover of a work (data/openLibrary.ts): its Open Library ID (P648),
  # else its title and author to search Open Library with.
  OPTIONAL { $entity wdt:P648 ?openLibraryId . FILTER(isLiteral(?openLibraryId)) }
  OPTIONAL {
    $entity wdt:P50 ?author .
    ?author rdfs:label ?authorName .
    FILTER(LANG(?authorName) = "en")
  }
  OPTIONAL {
    ?article schema:about $entity ;
      schema:isPartOf <https://en.wikipedia.org/> .
    FILTER(isIRI(?article))
  }
}
LIMIT 1000
