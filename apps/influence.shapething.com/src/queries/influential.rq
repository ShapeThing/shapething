PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

# The 50 most influential things of the class $class (data/searchClasses.ts): philosophers, bands,
# programming languages and the like, by how many others they influenced
# (wdt:P737 is "influenced by"). Where "Surprise me" on the search page starts: only the item, the
# rest comes with the chain.
SELECT ?item WHERE {
  {
    SELECT ?item (COUNT(DISTINCT ?influenced) AS ?count) WHERE {
      # The class and its kinds, found once and joined on, so Wikidata does not walk the subclass
      # path for every thing with an influence (a filter with a P31/P279* path took up to a minute).
      { SELECT ?class WHERE { ?class wdt:P279* $class } }
      ?influenced wdt:P737 ?item .
      # An instance of it (wdt:P31) or with it as occupation (wdt:P106): $membership.
      ?item $membership ?class .
      FILTER(isIRI(?item))
      # The philosophers (Q4964182) have most of the influences on Wikidata, and many are writers
      # or scientists too (Marx is an economist): the other kinds of people leave them out, else
      # they all start with Marx, Kant and Nietzsche. The search still finds them (search.rq).
      FILTER($class = wd:Q4964182 || NOT EXISTS { ?item wdt:P106 wd:Q4964182 })
    }
    GROUP BY ?item
    ORDER BY DESC(?count)
    LIMIT 50
  }
}
