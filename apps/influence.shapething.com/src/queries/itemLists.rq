PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd: <http://www.bigdata.com/rdf#>
PREFIX schema: <http://schema.org/>
PREFIX inf: <https://influence.shapething.com/ns#>

# What $subject made, by the kind of maker: works (P50 author), albums (P175 performer) and
# artworks (P170 creator), and their interests (P101 field of work) and notable works (P800, shown
# as ideas), in one request: the tabs of a person's modal (src/shapes/PersonModalShape.ttl), as
# Wikidata's own triples, each item with its name, description, image and dates. Besides those, a
# book's or an album's cover (inf:cover, as in entity.rq), and the life events of $subject: its
# birth and death (a band's forming and breaking up) as events with a date (P585, point in time),
# so they take their place on the timeline of each list it has (inf:worksEvent…), and a list it
# does not have stays empty.
#
# The names come from Wikidata's label service, which looks them up after the UNION, only for the
# items it found: about 40% faster than an OPTIONAL rdfs:label lookup per language in each branch.
# It gives the English label, else the "mul" one, else the bare identifier as a plain literal
# without a language: an item without a readable name is left out.
CONSTRUCT {
  ?work wdt:P50 $subject .
  ?album wdt:P175 $subject .
  ?artwork wdt:P170 $subject .
  $subject wdt:P101 ?interest ;
    wdt:P800 ?idea ;
    inf:worksEvent ?worksEvent ;
    inf:albumsEvent ?albumsEvent ;
    inf:artworksEvent ?artworksEvent .
  ?item rdfs:label ?name ;
    schema:description ?description ;
    wdt:P18 ?image ;
    wdt:P571 ?inception ;
    wdt:P577 ?publicationDate ;
    inf:cover ?cover .
  ?event inf:eventLabel ?eventLabel ;
    wdt:P585 ?eventDate .
}
WHERE {
  {
    ?item wdt:P50 $subject .
    FILTER(isIRI(?item))
    # Editions and translations (P629 edition or translation of) are items of their own with the
    # same author and usually the same title: leave them out when their work is listed already.
    FILTER NOT EXISTS { ?item wdt:P629 ?work . ?work wdt:P50 $subject }
    # Not works of their own: an edition or translation (Q3331189) without P629, or a Wikimedia
    # list article (Q13406463), e.g. "fictional places in the Narnia series".
    FILTER NOT EXISTS { VALUES ?notAWork { wd:Q3331189 wd:Q13406463 } ?item wdt:P31 ?notAWork }
    # A series (any subclass of Q7725310 series of creative works, e.g. The Chronicles of Narnia):
    # its books are listed one by one.
    FILTER NOT EXISTS { ?item wdt:P31/wdt:P279* wd:Q7725310 }
    BIND(?item AS ?work)
    OPTIONAL { ?item wdt:P571 ?inception . FILTER(isLiteral(?inception)) }
    OPTIONAL { ?item wdt:P577 ?publicationDate . FILTER(isLiteral(?publicationDate)) }
    # The cover of a work or an edition on Open Library.
    OPTIONAL {
      ?item wdt:P648 ?openLibraryId .
      FILTER(REGEX(STR(?openLibraryId), "^OL[0-9]+[WM]$"))
      BIND(IRI(CONCAT("https://covers.openlibrary.org/", IF(STRENDS(STR(?openLibraryId), "W"), "w", "b"), "/olid/", STR(?openLibraryId), "-L.jpg?default=false")) AS ?cover)
    }
  }
  UNION
  {
    # The albums and EPs (Q482994, Q169930) $subject performed (P175): only those Wikidata says are
    # a studio, live or soundtrack album (P7937 form of creative work), which leaves out the many
    # compilations, remixes and box sets, and the releases nobody described.
    ?item wdt:P175 $subject .
    FILTER(isIRI(?item))
    FILTER EXISTS { VALUES ?albumType { wd:Q482994 wd:Q169930 } ?item wdt:P31 ?albumType }
    FILTER EXISTS { VALUES ?albumForm { wd:Q208569 wd:Q209939 wd:Q4176708 } ?item wdt:P7937 ?albumForm }
    BIND(?item AS ?album)
    OPTIONAL { ?item wdt:P577 ?publicationDate . FILTER(isLiteral(?publicationDate)) }
    # The cover of an album on the Cover Art Archive, by its MusicBrainz release group.
    OPTIONAL {
      ?item wdt:P436 ?musicBrainzId .
      FILTER(isLiteral(?musicBrainzId))
      BIND(IRI(CONCAT("https://coverartarchive.org/release-group/", STR(?musicBrainzId), "/front-500")) AS ?cover)
    }
  }
  UNION
  {
    # The paintings, sculptures and drawings (Q3305213, Q860861, Q93184) $subject made (P170
    # creator): a painter can have well over a thousand, so only the best known 100, by the number
    # of Wikimedia sites with an article about them (at least three).
    {
      SELECT ?item WHERE {
        ?item wdt:P170 $subject ; wikibase:sitelinks ?sitelinks .
        FILTER(isIRI(?item) && ?sitelinks >= 3)
        FILTER EXISTS { VALUES ?artworkType { wd:Q3305213 wd:Q860861 wd:Q93184 } ?item wdt:P31 ?artworkType }
      }
      ORDER BY DESC(?sitelinks)
      LIMIT 100
    }
    BIND(?item AS ?artwork)
    OPTIONAL { ?item wdt:P571 ?inception . FILTER(isLiteral(?inception)) }
  }
  UNION
  {
    $subject wdt:P101 ?item .
    FILTER(isIRI(?item))
    BIND(?item AS ?interest)
  }
  UNION
  {
    $subject wdt:P800 ?item .
    FILTER(isIRI(?item))
    BIND(?item AS ?idea)
  }
  OPTIONAL { ?item wdt:P18 ?image . FILTER(isIRI(?image)) }
  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en,mul" .
    ?item rdfs:label ?name .
    ?item schema:description ?anyDescription .
  }
  FILTER(LANG(?name) != "")
  # Like the name, a description without a language is no description.
  BIND(IF(LANG(?anyDescription) != "", ?anyDescription, ?none) AS ?description)
  # The life events of $subject, on the timeline of each list it has: with the rows of that list.
  OPTIONAL {
    VALUES (?eventKey ?eventLabel ?eventProperty) {
      ("born" "Born"@en wdt:P569)
      ("died" "Died"@en wdt:P570)
      ("formed" "Formed"@en wdt:P571)
      ("disbanded" "Disbanded"@en wdt:P576)
    }
    $subject ?eventProperty ?eventDate .
    FILTER(isLiteral(?eventDate))
    BIND(IRI(CONCAT(STR(inf:), ?eventKey, "-", STRAFTER(STR($subject), STR(wd:)))) AS ?event)
  }
  BIND(IF(BOUND(?work), ?event, ?none) AS ?worksEvent)
  BIND(IF(BOUND(?album), ?event, ?none) AS ?albumsEvent)
  BIND(IF(BOUND(?artwork), ?event, ?none) AS ?artworksEvent)
}
