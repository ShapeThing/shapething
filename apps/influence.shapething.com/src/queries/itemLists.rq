PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# The works (P50 author), interests (P101 field of work) and notable works (P800, shown as ideas) of
# $subject in one request. The label lookups must stay inside each branch: shared after the UNION,
# the query planner starts from "all labels" and the query times out.
SELECT ?kind ?item ?name ?mulName ?publicationDate WHERE {
  {
    ?item wdt:P50 $subject .
    FILTER(isIRI(?item))
    BIND("works" AS ?kind)
    OPTIONAL { ?item rdfs:label ?name . FILTER(LANG(?name) = "en") }
    OPTIONAL { ?item rdfs:label ?mulName . FILTER(LANG(?mulName) = "mul") }
    OPTIONAL { ?item wdt:P577 ?publicationDate . FILTER(isLiteral(?publicationDate)) }
  }
  UNION
  {
    $subject wdt:P101 ?item .
    FILTER(isIRI(?item))
    BIND("interests" AS ?kind)
    OPTIONAL { ?item rdfs:label ?name . FILTER(LANG(?name) = "en") }
    OPTIONAL { ?item rdfs:label ?mulName . FILTER(LANG(?mulName) = "mul") }
  }
  UNION
  {
    $subject wdt:P800 ?item .
    FILTER(isIRI(?item))
    BIND("ideas" AS ?kind)
    OPTIONAL { ?item rdfs:label ?name . FILTER(LANG(?name) = "en") }
    OPTIONAL { ?item rdfs:label ?mulName . FILTER(LANG(?mulName) = "mul") }
  }
}
LIMIT 2000
