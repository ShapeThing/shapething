PREFIX wdt: <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# The people that influenced $subject (wdt:P737 is "influenced by"), the most influential first. The
# count is computed first, in a sub query: grouping the outer query would have to aggregate the
# optional values too, and an aggregate of an unbound value can not be typed as optional.
SELECT ?item ?name ?mulName ?image ?birthDate ?deathDate ?inception ?dissolved (xsd:integer(?count) AS ?influence) WHERE {
  {
    SELECT ?item (COUNT(DISTINCT ?influenced) AS ?count) WHERE {
      $subject wdt:P737 ?item .
      FILTER(isIRI(?item))
      OPTIONAL { ?influenced wdt:P737 ?item }
    }
    GROUP BY ?item
    ORDER BY DESC(?count)
    LIMIT 1000
  }
  # Since Wikidata has "mul" (default for all languages) labels, many people have no English one.
  OPTIONAL { ?item rdfs:label ?name . FILTER(LANG(?name) = "en") }
  OPTIONAL { ?item rdfs:label ?mulName . FILTER(LANG(?mulName) = "mul") }
  OPTIONAL { ?item wdt:P18 ?image . FILTER(isIRI(?image)) }
  # An unknown date is a blank node (skolemized to an IRI), not a literal.
  OPTIONAL { ?item wdt:P569 ?birthDate . FILTER(isLiteral(?birthDate)) }
  OPTIONAL { ?item wdt:P570 ?deathDate . FILTER(isLiteral(?deathDate)) }
  # A band's dates: when it was formed (P571, inception) and when it broke up (P576, dissolved).
  OPTIONAL { ?item wdt:P571 ?inception . FILTER(isLiteral(?inception)) }
  OPTIONAL { ?item wdt:P576 ?dissolved . FILTER(isLiteral(?dissolved)) }
}
ORDER BY DESC(?count)
