@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix stsr: <http://ontology.shapething.com/shacl-renderer#> .
@prefix prop: <http://ontology.shapething.com/shacl-renderer/props/> .

<>
  a sh:NodeShape, stsr:Shape ;
  sh:targetClass stsr:Props ;

  sh:property [
    sh:name "Mode" ;
    sh:path prop:mode ;
    sh:in ( "edit" "view" "facet" ) ;
    sh:description "Do you want to show a form, display the data or show search facets?" ;
    sh:maxCount 1;
  ];

  sh:property [
    sh:name "Focus node" ;
    sh:path prop:focusNode ;
    sh:maxCount 1;
    sh:description "The resource to render, a resource URI. Defaults to the data's own <> resource." ;
  ];

  sh:property [
    sh:name "Node shapes" ;
    sh:path prop:nodeShape ;
    sh:description "The node shapes to render the focus node with, resource URIs. Defaults to the shapes targeting the focus node." ;
  ];

  sh:property [
    sh:name "Language mode" ;
    sh:path prop:languageMode ;
    sh:in ( "switcher" "individual" ) ;
    sh:maxCount 1;
    sh:description "Show one content language at a time with a global switcher, or every translation side by side." ;
  ];

  sh:property [
    sh:name "Enable focus node editor" ;
    sh:path prop:enableFocusNodeEditor ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1;
    sh:description "Show an identifier field for the IRI of the resource being edited." ;
  ];

  sh:property [
    sh:name "Enable widget switching" ;
    sh:path prop:enableWidgetSwitching ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1;
    sh:description "Allow switching between the widgets available for a property." ;
  ];

  sh:property [
    sh:name "Enable title" ;
    sh:path prop:enableTitle ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1;
    sh:description "Render a heading above the form." ;
  ];
.
