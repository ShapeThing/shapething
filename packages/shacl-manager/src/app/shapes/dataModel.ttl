@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix dcterms: <http://purl.org/dc/terms/>.
@prefix vann: <http://purl.org/vocab/vann/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix st: <http://shapething.com/>.
@prefix meta: <http://shapething.com/shacl-manager/data-model-meta#>.

# How the data model itself is shown: the subject of its own graph, an owl:Ontology and
# sh:ShapesGraph. Predicates not declared here are generated into meta:other.
meta:dataModel
    a sh:NodeShape ;
    st:missingPropertiesGroup meta:other ;

    # General

    sh:property [
        sh:order 0 ;
        sh:name "Name"@en, "Naam"@nl ;
        sh:path [ sh:alternativePath ( rdfs:label dcterms:title ) ] ;
        sh:group meta:general ;
        sh:datatype ( xsd:string rdf:langString ) ;
    ] ;

    sh:property [
        sh:order 1 ;
        sh:name "Description"@en, "Beschrijving"@nl ;
        sh:path [ sh:alternativePath ( rdfs:comment dcterms:description ) ] ;
        sh:group meta:general ;
        sh:datatype ( xsd:string rdf:langString ) ;
        sh:singleLine false ;
    ] ;

    sh:property [
        sh:order 2 ;
        sh:name "Version"@en, "Versie"@nl ;
        sh:path owl:versionInfo ;
        sh:group meta:general ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:order 3 ;
        sh:name "Prefix"@en, "Prefix"@nl ;
        sh:description "A short name for this data model, such as \"dcat\". The sidebar marks the data model's own classes and shapes with it."@en,
            "Een korte naam voor dit datamodel, zoals \"dcat\". De zijbalk markeert de eigen klassen en shapes van het datamodel ermee."@nl ;
        sh:path vann:preferredNamespacePrefix ;
        sh:group meta:general ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:order 4 ;
        sh:name "Type"@en, "Type"@nl ;
        sh:path rdf:type ;
        sh:group meta:general ;
        sh:nodeKind sh:IRI ;
    ] ;

    # Imports

    sh:property [
        sh:order 0 ;
        sh:name "Imports"@en, "Importeert"@nl ;
        sh:description "Ontologies and shapes graphs this data model builds on, by their IRI. Their shapes and classes appear under Imported."@en,
            "Ontologieën en shapes graphs waar dit datamodel op voortbouwt, op hun IRI. Hun shapes en klassen staan onder Geïmporteerd."@nl ;
        sh:path owl:imports ;
        sh:group meta:imports ;
        sh:nodeKind sh:IRI ;
    ] ;

    # Prefixes

    sh:property [
        sh:order 0 ;
        sh:name "Prefix declarations"@en, "Prefixdeclaraties"@nl ;
        sh:description "Prefixes the SPARQL constraints and rules in this data model may use, each a prefix and its namespace."@en,
            "Prefixen die de SPARQL-constraints en -regels in dit datamodel mogen gebruiken, elk een prefix en zijn namespace."@nl ;
        sh:path sh:declare ;
        sh:group meta:prefixes ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        shui:editor shui:DetailsEditor ;
        shui:viewer shui:DetailsViewer ;
        sh:node meta:prefixDeclaration ;
    ] .

meta:prefixDeclaration
    a sh:NodeShape ;
    sh:property [
        sh:order 0 ;
        sh:name "Prefix"@en, "Prefix"@nl ;
        sh:path sh:prefix ;
        sh:group meta:prefixDeclarationFields ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:order 1 ;
        sh:name "Namespace"@en, "Namespace"@nl ;
        sh:path sh:namespace ;
        sh:group meta:prefixDeclarationFields ;
        sh:datatype xsd:anyURI ;
        # No editor scores xsd:anyURI literals; a text field writes them back with the datatype.
        shui:editor shui:TextFieldEditor ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

# A prefix and its namespace side by side.
meta:prefixDeclarationFields
    a st:HorizontalPropertyGroup ;
    sh:order 0 .

meta:general
    a sh:PropertyGroup ;
    sh:name "General"@en, "Algemeen"@nl ;
    sh:order 0 .

meta:imports
    a sh:PropertyGroup ;
    sh:name "Imports"@en, "Imports"@nl ;
    sh:order 1 .

meta:prefixes
    a sh:PropertyGroup ;
    sh:name "Prefixes"@en, "Prefixen"@nl ;
    sh:order 2 .

meta:other
    a sh:PropertyGroup ;
    sh:name "Other"@en, "Overig"@nl ;
    sh:order 3 .
