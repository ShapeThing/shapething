PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

# The SHACL rules (SHACL-AF sh:rule: sh:SPARQLRule, sh:TripleRule) for the rules tab. Rules hang
# off node shapes only. One row per (rule, label); a rule without rdfs:label gets one row with
# ?label unbound. Rows come per shape, in rule execution order (sh:order, default 0).
#
# Input variables, bound by the caller (Comunica initialBindings):
#   ?subject    the class or shape the page is about
#   ?kind       "shape": the rules of ?subject itself
#               "class": the rules of every shape of ?origin with sh:targetClass ?subject
#   ?dataModel  the data model's graph IRI
#   ?origin     "managed" (shapes declared in the data model's own graph) or "imported" (any other);
#               only used for "class"
SELECT ?shape ?rule ?order ?label ?deactivated WHERE {
  {
    FILTER(?kind = "shape")
    BIND(?subject AS ?shape)
  } UNION {
    FILTER(?kind = "class")
    GRAPH ?graph { ?shape sh:targetClass ?subject }
    FILTER(IF(?graph = ?dataModel, "managed", "imported") = ?origin)
  }

  ?shape sh:rule ?rule .
  OPTIONAL { ?rule sh:order ?order }
  OPTIONAL { ?rule rdfs:label ?label }
  OPTIONAL { ?rule sh:deactivated ?deactivated }
}
ORDER BY ?shape COALESCE(?order, 0) ?rule
