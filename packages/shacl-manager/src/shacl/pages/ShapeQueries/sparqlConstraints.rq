PREFIX sh: <http://www.w3.org/ns/shacl#>

# The SPARQL-based constraints (sh:sparql) for the queries tab: those on a shape itself and those on
# its property shapes. One row per (constraint, message); a constraint without sh:message gets one
# row with ?message unbound. Rows come per shape, node-level constraints before property-level ones.
#
# Input variables, bound by the caller (Comunica initialBindings):
#   ?subject    the class or shape the page is about
#   ?kind       "shape": the constraints of ?subject itself
#               "class": the constraints of every shape of ?origin with sh:targetClass ?subject
#   ?dataModel  the data model's graph IRI
#   ?origin     "managed" (shapes declared in the data model's own graph) or "imported" (any other);
#               only used for "class"
SELECT ?shape ?propertyShape ?path ?constraint ?select ?message ?deactivated WHERE {
  {
    FILTER(?kind = "shape")
    BIND(?subject AS ?shape)
  } UNION {
    FILTER(?kind = "class")
    GRAPH ?graph { ?shape sh:targetClass ?subject }
    FILTER(IF(?graph = ?dataModel, "managed", "imported") = ?origin)
  }

  # On the shape itself, or on one of its property shapes. ?propertyShape and ?path stay unbound
  # for a node-level constraint (an OPTIONAL rather than a UNION, so the generated row type knows).
  ?shape sh:sparql|(sh:property/sh:sparql) ?constraint .
  OPTIONAL {
    ?shape sh:property ?propertyShape .
    ?propertyShape sh:sparql ?constraint .
    OPTIONAL { ?propertyShape sh:path ?path }
  }

  OPTIONAL { ?constraint sh:select ?select }
  OPTIONAL { ?constraint sh:message ?message }
  OPTIONAL { ?constraint sh:deactivated ?deactivated }
}
ORDER BY ?shape BOUND(?propertyShape) ?propertyShape ?constraint
