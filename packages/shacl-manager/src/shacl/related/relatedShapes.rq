PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

# The shapes that, through a target other than sh:targetClass, also apply to the focus nodes of
# the class or shape the page is about. One row per (related shape, mechanism, via):
#   targetSubjectsOf  ?via is a predicate the subject's focus nodes have: a property shape with
#                     sh:path ?via, or the subject's own sh:targetSubjectsOf ?via
#   targetObjectsOf   ?via is a predicate the subject's focus nodes are the object of: a property
#                     shape with sh:path [ sh:inversePath ?via ], or its own sh:targetObjectsOf ?via
#   targetNode        ?via is a node the subject also targets: an instance (rdf:type, through
#                     rdfs:subClassOf) of one of its target classes, or its own sh:targetNode ?via
# ?shapeOrigin is the origin of the graph declaring the related shape's target, from either origin,
# so the sidebar can link to it.
#
# Input variables, bound by the caller (Comunica initialBindings):
#   ?subject    the class or shape the page is about
#   ?kind       "shape": the focus nodes of ?subject itself
#               "class": the focus nodes of every shape of ?origin with sh:targetClass ?subject
#   ?dataModel  the data model's graph IRI
#   ?origin     "managed" (shapes declared in the data model's own graph) or "imported" (any other);
#               only used for "class"
SELECT DISTINCT ?shape ?shapeOrigin ?mechanism ?via WHERE {
  {
    FILTER(?kind = "shape")
    BIND(?subject AS ?own)
  } UNION {
    FILTER(?kind = "class")
    GRAPH ?ownGraph { ?own sh:targetClass ?subject }
    FILTER(IF(?ownGraph = ?dataModel, "managed", "imported") = ?origin)
  }

  {
    { ?own sh:property/sh:path ?via } UNION { ?own sh:targetSubjectsOf ?via }
    FILTER(isIRI(?via))
    GRAPH ?graph { ?shape sh:targetSubjectsOf ?via }
    BIND("targetSubjectsOf" AS ?mechanism)
  } UNION {
    { ?own sh:property/sh:path/sh:inversePath ?via } UNION { ?own sh:targetObjectsOf ?via }
    FILTER(isIRI(?via))
    GRAPH ?graph { ?shape sh:targetObjectsOf ?via }
    BIND("targetObjectsOf" AS ?mechanism)
  } UNION {
    { ?own sh:targetClass ?class . ?via rdf:type/rdfs:subClassOf* ?class }
    UNION { ?own sh:targetNode ?via }
    GRAPH ?graph { ?shape sh:targetNode ?via }
    BIND("targetNode" AS ?mechanism)
  }

  FILTER(?shape != ?own)
  BIND(IF(?graph = ?dataModel, "managed", "imported") AS ?shapeOrigin)
}
ORDER BY ?shape ?mechanism ?via
