PREFIX sh: <http://www.w3.org/ns/shacl#>

# The property groups for the sidebar's "Property groups" section: one row per group, flat. Rows
# come by sh:order (groups without one last), then most property shapes first.
#
# Input variables, bound by the caller (Comunica initialBindings):
#   ?dataModel  the data model's graph IRI
#   ?origin     "managed" (groups declared in the data model's own graph) or "imported" (any other)
SELECT ?group (COUNT(DISTINCT ?property) AS ?propertyCount) (MIN(?anyOrder) AS ?order) WHERE {
  # A group is a declared sh:PropertyGroup, or anything a property shape points at with sh:group.
  # Its origin is the graph that declares it.
  GRAPH ?graph {
    { ?group a sh:PropertyGroup } UNION { ?anyProperty sh:group ?group }
  }
  FILTER(IF(?graph = ?dataModel, "managed", "imported") = ?origin)

  OPTIONAL { ?property sh:group ?group }
  OPTIONAL { ?group sh:order ?anyOrder }
}
GROUP BY ?group
ORDER BY (!BOUND(?order)) ?order DESC(?propertyCount) ?group
