PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX sh: <http://www.w3.org/ns/shacl#>

# One row per (shape, parent) edge of the shapes sidebar, parent unbound for a root, most
# properties, queries and rules (as its tabs list them) together first.
# Inputs: ?dataModel, ?origin, ?section ("hierarchy": shapes with an sh:targetClass, "other": the rest).
SELECT ?shape ?parent (COUNT(DISTINCT ?property) AS ?propertyCount)
  (COUNT(DISTINCT ?query) AS ?queryCount) (COUNT(DISTINCT ?rule) AS ?ruleCount) WHERE {
  GRAPH ?graph {
    { ?shape a sh:NodeShape } UNION { ?shape sh:targetClass ?anyTargetClass }
  }
  FILTER(IF(?graph = ?dataModel, "managed", "imported") = ?origin)
  FILTER(EXISTS { ?shape sh:targetClass ?someTargetClass } = (?section = "hierarchy"))

  # The parent targets the nearest superclass that has a shape of the same origin.
  OPTIONAL {
    FILTER(?section = "hierarchy")
    ?shape sh:targetClass ?class .
    ?class rdfs:subClassOf+ ?superClass .
    FILTER(?superClass != ?class)
    GRAPH ?parentGraph { ?parent sh:targetClass ?superClass }
    FILTER(IF(?parentGraph = ?dataModel, "managed", "imported") = ?origin)
    FILTER(?parent != ?shape)
    FILTER NOT EXISTS {
      ?class rdfs:subClassOf+ ?between .
      ?between rdfs:subClassOf+ ?superClass .
      FILTER(?between != ?class && ?between != ?superClass)
      GRAPH ?betweenGraph { ?betweenShape sh:targetClass ?between }
      FILTER(IF(?betweenGraph = ?dataModel, "managed", "imported") = ?origin)
    }
  }

  OPTIONAL { ?shape sh:property ?property }
  OPTIONAL { ?shape sh:sparql|(sh:property/sh:sparql) ?query }
  OPTIONAL { ?shape sh:rule ?rule }
}
GROUP BY ?shape ?parent
ORDER BY DESC(?propertyCount + ?queryCount + ?ruleCount) ?shape
