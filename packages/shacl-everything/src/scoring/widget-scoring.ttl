PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

#####################
# Data Graph Shapes #
#####################

shui:isBlankNode
    a sh:NodeShape ;
    sh:nodeKind sh:BlankNode ;
.

shui:isBoolean
    a sh:NodeShape ;
    sh:datatype xsd:boolean ;
.

shui:isDate
    a sh:NodeShape ;
    sh:datatype xsd:date ;
.

shui:isDateTime
    a sh:NodeShape ;
    sh:datatype xsd:dateTime ;
.

shui:isIRI
    a sh:NodeShape ;
    sh:nodeKind sh:IRI ;
.

shui:isIRIOrBlankNode
    a sh:NodeShape ;
    sh:or (
        [
            sh:nodeKind sh:IRI ;
        ]
        [
            sh:nodeKind sh:BlankNode ;
        ]
    ) ;
.

shui:isHTML
    a sh:NodeShape ;
    sh:datatype rdf:HTML ;
.

shui:isHTMLOrString
    a sh:NodeShape ;
    sh:or (
        [
            sh:datatype rdf:HTML ;
        ]
        [
            sh:datatype xsd:string ;
        ]
    ) ;
.

shui:isString
    a sh:NodeShape ;
    sh:datatype xsd:string ;
.

shui:isLangString
    a sh:NodeShape ;
    sh:datatype rdf:langString ;
.

shui:isAnyURI
    a sh:NodeShape ;
    sh:datatype xsd:anyURI ;
.

shui:isAnyURIOrString
    a sh:NodeShape ;
    sh:or (
        [
            sh:datatype xsd:anyURI ;
        ]
        [
            sh:datatype xsd:string ;
        ]
    ) ;
.

shui:hasImageFileExtension
    a sh:NodeShape ;
    sh:or (
        [
            sh:nodeKind sh:IRI
        ]
        [
            sh:nodeKind sh:Literal
        ]
    ) ;
    sh:pattern "\\.(jpg|jpeg|png|gif|bmp|svg|webp|avif)$" ;
    sh:flags "i" ;
.

shui:isNumericLiteral
    a sh:NodeShape ;
    sh:or (
        [
            sh:datatype xsd:decimal ;
        ]
        [
            sh:datatype xsd:integer ;
        ]
        [
            sh:datatype xsd:double ;
        ]
        [
            sh:datatype xsd:float ;
        ]
    ) ;
.

shui:isLiteral
    a sh:NodeShape ;
    sh:nodeKind sh:Literal ;
.


#######################
# Shapes Graph Shapes #
#######################

shui:isSingleLineTrue
    a sh:NodeShape ;
    sh:property [
        sh:path sh:singleLine ;
        sh:minCount 1 ;
        sh:hasValue true ;
    ] ;
.

shui:isSingleLineFalse
    a sh:NodeShape ;
    sh:property [
        sh:path sh:singleLine ;
        sh:minCount 1 ;
        sh:hasValue false ;
    ] ;
.

shui:hasInConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path sh:in ;
        sh:minCount 1 ;
    ] ;
.

shui:hasSearchQueryConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path shui:searchQuery ;
        sh:minCount 1 ;
    ] ;
.

shui:hasClassConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path sh:class ;
        sh:minCount 1 ;
    ] ;
.

shui:hasNoClassConstraint
    a sh:NodeShape ;
    sh:not shui:hasClassConstraint ;
.

shui:hasDatatypeConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path sh:datatype ;
        sh:minCount 1 ;
    ] ;
.

shui:hasNodeKindConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path sh:nodeKind ;
        sh:minCount 1 ;
    ] ;
.

# A property shape carrying no value-type signal whatsoever - no sh:datatype, sh:nodeKind or
# sh:class (e.g. a shape that only states sh:minCount/sh:maxCount plus a human-readable sh:name,
# common in profiles like DCAT-AP-NL that leave the value's exact type to be inferred from context
# rather than declared). Every other editor's shapesGraphShape rule requires at least one of these
# three to fire, so a property like this scores nothing at all pre-value - see
# TextFieldEditor/score.ttl's own fallback rule, the one place this is used.
shui:hasNoTypeConstraint
    a sh:NodeShape ;
    sh:not shui:hasDatatypeConstraint ;
    sh:not shui:hasNodeKindConstraint ;
    sh:not shui:hasClassConstraint ;
.

shui:hasRootClassConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path sh:rootClass ;
        sh:minCount 1 ;
    ] ;
.

# A property whose own path is exactly the skos:inScheme predicate (a direct predicate path, not a
# compound one) - used by st:CategoryFacet to recognize a SKOS classification property even when it
# declares no sh:class of its own (skos:Concept values are typically only reachable via
# skos:inScheme, not typed as a class shapesGraph can see).
shui:hasSkosInSchemePathConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path sh:path ;
        sh:hasValue skos:inScheme ;
    ] ;
.

# sh:datatype and sh:nodeKind can, per SHACL 1.2, hold either a plain IRI or a SHACL list of IRIs
# (e.g. `sh:datatype ( xsd:string xsd:langString )`) - a plain `sh:path sh:datatype ; sh:hasValue
# ...` can only ever see the list's head blank node, never its members (spec issue #1179). Every
# shape below that inspects sh:datatype/sh:nodeKind is therefore an sh:or of the direct-value case
# (unchanged) and a second branch walking the list via `sh:datatype/rdf:rest*/rdf:first` - written
# as the sequence path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) since shacl-engine's
# path parser doesn't support nesting a compound sub-path inside sh:zeroOrOnePath/sh:alternativePath.

shui:hasCustomDatatype
    a sh:NodeShape ;
    sh:property [
        sh:path sh:datatype ;
        sh:minCount 1 ;
    ] ;
    sh:or (
        [
            # Direct case: exactly one value node, so a plain "does it fail to match the
            # well-known-prefix pattern" check is safe. sh:nodeKind sh:IRI excludes a SHACL list's
            # head blank node (which would otherwise also trivially fail the pattern match and be
            # mistaken for "custom") - list-valued sh:datatype is handled by the second branch only.
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:nodeKind sh:IRI ;
            ] ;
            sh:not [
                sh:property [
                    sh:path sh:datatype ;
                    sh:minCount 1 ;
                    sh:pattern "^http://www.w3.org/2001/XMLSchema#|^http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
                ] ;
            ] ;
        ]
        [
            # List case: an existential "at least one member is custom" check, via
            # sh:qualifiedValueShape - a plain sh:pattern here would instead require *every* member
            # to be custom, wrongly rejecting a list that mixes well-known and custom datatypes.
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:qualifiedValueShape [
                    sh:not [
                        sh:pattern "^http://www.w3.org/2001/XMLSchema#|^http://www.w3.org/1999/02/22-rdf-syntax-ns#" ;
                    ] ;
                ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ]
    ) ;
.

#  sh:nodeKind sh:BlankNodeOrIRI is a distinct, legal sh:NodeKind value (not shorthand for a list
#  of sh:IRI/sh:BlankNode) - treated as IRI-ish here too, since a property that only rules out
#  plain literals is otherwise left with zero shape-only scoring signal at all (no candidate value
#  exists yet to fall back on a dataGraphShape check either), leaving it without any widget until a
#  value is first added by some other means. Each accepted value is its own sh:hasValue branch
#  (existential "equals A or equals B"), not sh:in on one property shape (universal "every matched
#  value must be A or B") - the list-walking path below can return more than one nodeKind member at
#  once (e.g. sh:nodeKind ( sh:IRI sh:BlankNode )), and sh:in would then also demand the sh:BlankNode
#  member be IRI-ish, which it isn't.
shui:hasNodeKindIRIConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:nodeKind ;
                sh:minCount 1 ;
                sh:hasValue sh:IRI ;
            ] ;
        ]
        [
            sh:property [
                sh:path sh:nodeKind ;
                sh:minCount 1 ;
                sh:hasValue sh:BlankNodeOrIRI ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:nodeKind [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue sh:IRI ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:nodeKind [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue sh:BlankNodeOrIRI ;
            ] ;
        ]
    ) ;
.

shui:hasNodeKindLiteralConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:nodeKind ;
                sh:minCount 1 ;
                sh:hasValue sh:Literal ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:nodeKind [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue sh:Literal ;
            ] ;
        ]
    ) ;
.

shui:hasDatatypeStringConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:hasValue xsd:string ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue xsd:string ;
            ] ;
        ]
    ) ;
.

shui:hasDatatypeLangStringConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:hasValue rdf:langString ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue rdf:langString ;
            ] ;
        ]
    ) ;
.

shui:hasDatatypeBooleanConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:hasValue xsd:boolean ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue xsd:boolean ;
            ] ;
        ]
    ) ;
.

shui:hasDatatypeDateConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:hasValue xsd:date ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue xsd:date ;
            ] ;
        ]
    ) ;
.

shui:hasDatatypeDateTimeConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:hasValue xsd:dateTime ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue xsd:dateTime ;
            ] ;
        ]
    ) ;
.

shui:hasDatatypeHTMLConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:hasValue rdf:HTML ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue rdf:HTML ;
            ] ;
        ]
    ) ;
.

shui:hasDatatypeNumericConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:or (
                    [ sh:hasValue xsd:decimal ]
                    [ sh:hasValue xsd:integer ]
                    [ sh:hasValue xsd:double ]
                    [ sh:hasValue xsd:float ]
                ) ;
            ] ;
        ]
        [
            # List case: sh:or nested in a property shape is a per-value-node (universal) check,
            # not an existential one like sh:hasValue - it would wrongly require *every* list
            # member to be numeric. sh:qualifiedValueShape gives the "at least one member is
            # numeric" semantics actually wanted here, same as hasCustomDatatype's list branch.
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:qualifiedValueShape [
                    sh:or (
                        [ sh:hasValue xsd:decimal ]
                        [ sh:hasValue xsd:integer ]
                        [ sh:hasValue xsd:double ]
                        [ sh:hasValue xsd:float ]
                    ) ;
                ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ]
    ) ;
.
