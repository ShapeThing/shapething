@prefix ex: <http://example.org/>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix st: <http://shapething.com/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:property [
        sh:name "Favorite color"@en, "Lievelingskleur"@nl ;
        sh:path ex:favoriteColor ;
        shui:viewer st:ColorViewer ;
    ] ;
    .

# #3b82f6 as HSL - h/s/l computed via helpers/colorBuckets.ts's own hexToHsl formula.
<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    ex:favoriteColor [
        st:hue "217.2192513368984"^^xsd:decimal ;
        st:saturation "91.21951219512198"^^xsd:decimal ;
        st:lightness "59.80392156862745"^^xsd:decimal ;
    ] ;
    .
