@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ex: <http://example.org/>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix st: <http://shapething.com/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:property [
        sh:name "Given name"@en ;
        sh:path schema:givenName ;
        sh:order 0 ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:group <#nameGroup> ;
    ] ;
    sh:property [
        sh:name "Family name"@en ;
        sh:path ex:familyName ;
        sh:order 1 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:group <#nameGroup> ;
    ] ;
    .

<#nameGroup>
    a sh:PropertyGroup, st:HorizontalPropertyGroup ;
    sh:name "Name"@en ;
    .

<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    ex:familyName "Jansen" .
