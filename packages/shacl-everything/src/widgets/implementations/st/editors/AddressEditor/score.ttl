PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Ported from shacl-renderer's own AddressEditor: opt-in only, via an explicit shui:editor
# declaration - unlike most editors here, it never auto-scores against sh:class/sh:node, since a
# schema:PostalAddress-shaped blank node has no signal distinguishing it from any other nested
# object a shape might declare (DetailsEditor already owns that generic case). No WidgetScore rule
# at all, therefore - select()'s own explicit-shui:editor fast path is what makes it selectable.
st:AddressEditor rdfs:label "Address"@en, "Adres"@nl .
