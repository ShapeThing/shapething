PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

st:IconifyEditor rdfs:label "Icon Picker"@en, "Icoonkiezer"@nl .

st:iconifyEditorScore40
    a shui:WidgetScore ;
    shui:widget st:IconifyEditor ;
    shui:score 40 ;
    shui:shapesGraphShape st:prefersIconifyEditor ;
.

# A property shape declaring sh:datatype <https://iconify.design> (see namespaces.ts's
# iconifyDatatype) always means "this value is an Iconify icon name" - beats TextFieldEditor's own
# generic hasCustomDatatype/fallback rules (score.ttl of that widget), which otherwise tie at 0/1
# for any datatype this codebase has no dedicated widget for.
st:iconifyEditorScoreDatatype
    a shui:WidgetScore ;
    shui:widget st:IconifyEditor ;
    shui:score 30 ;
    shui:shapesGraphShape st:hasIconifyDatatypeConstraint ;
.

st:prefersIconifyEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue st:IconifyEditor ;
    ] ;
.

st:hasIconifyDatatypeConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path sh:datatype ;
        sh:hasValue <https://iconify.design> ;
    ] ;
.
