PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Opt-in only: unlike EnumSelectEditor/InstancesSelectEditor, a plain sh:class constraint alone
# never scores this widget - a shape author picks it explicitly for a small, already-known set of
# instances that should render as a flat list of radios/checkboxes (optionally swapped for
# clickable images - see widget.tsx's hasDepictionRole) rather than a dropdown/typeahead. No
# WidgetScore rule at all, therefore - select()'s own explicit-shui:editor fast path is what makes
# it selectable.
st:RadiosCheckboxesEditor rdfs:label "Radios/Checkboxes"@en, "Keuzerondjes/-vakjes"@nl .
