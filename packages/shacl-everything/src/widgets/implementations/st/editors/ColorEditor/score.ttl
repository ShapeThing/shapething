PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Opt-in only, via an explicit shui:editor declaration - see AddressEditor/score.ttl for why an
# editor of a compound blank node (here: st:hue/st:saturation/st:lightness, see widget.tsx) never
# auto-scores against sh:node - there's no reliable signal distinguishing it from any other nested
# object a shape might declare. No WidgetScore rule at all, therefore - select()'s own explicit-
# shui:editor fast path is what makes it selectable.
st:ColorEditor rdfs:label "Color Picker"@en, "Kleurkiezer"@nl .
