PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

st:FileUploadEditor rdfs:label "File upload"@en, "Bestand uploaden"@nl .

st:fileUploadEditorScore40
    a shui:WidgetScore ;
    shui:widget st:FileUploadEditor ;
    shui:score 40 ;
    shui:shapesGraphShape st:prefersFileUploadEditor ;
.

# A property shape declaring st:uploadUrl (the multipart-POST endpoint this widget's own
# widget.tsx reads via shape.get(st("uploadUrl"))) is just as unambiguous a signal as an explicit
# shui:editor declaration - no other widget could sensibly do anything with that annotation.
st:fileUploadEditorScoreUploadUrl
    a shui:WidgetScore ;
    shui:widget st:FileUploadEditor ;
    shui:score 40 ;
    shui:shapesGraphShape st:hasUploadUrlConstraint ;
.

st:prefersFileUploadEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue st:FileUploadEditor ;
    ] ;
.

st:hasUploadUrlConstraint
    a sh:NodeShape ;
    sh:property [
        sh:path st:uploadUrl ;
        sh:minCount 1 ;
    ] ;
.
