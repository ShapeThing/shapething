@prefix ex: <http://example.org/>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix st: <http://shapething.com/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:property [
        sh:name "Photos"@en, "Foto's"@nl ;
        sh:path schema:image ;
        sh:nodeKind sh:IRI ;
        shui:editor st:FileUploadEditor ;
        st:uploadUrl "/storage-service-worker" ;
    ] ;
    .


<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    schema:image <./sample.svg> ;
    .
