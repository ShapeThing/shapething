PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

st:DateTimeRangeFacet rdfs:label "Date & Time Range"@en, "Datum- en tijdbereik"@nl .

st:dateTimeRangeFacetScore10
    a shui:WidgetScore ;
    st:facet st:DateTimeRangeFacet ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeDateTimeConstraint ;
.
