PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Opt-in only, via an explicit st:facet declaration - see st:ColorEditor/score.ttl (and
# AddressEditor/score.ttl, the same idiom this is ported from) for why a facet over a compound
# blank node never auto-scores against sh:node. No WidgetScore rule at all, therefore - select()'s
# own explicit-st:facet fast path is what makes it selectable.
st:ColorFacet rdfs:label "Color"@en, "Kleur"@nl .
