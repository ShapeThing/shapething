PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX st: <http://shapething.com/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geosparql: <http://www.opengis.net/ont/geosparql#>

st:MapFacet rdfs:label "Map"@en, "Kaart"@nl .

st:mapFacetScore40
    a shui:WidgetScore ;
    shui:widget st:MapFacet ;
    shui:score 40 ;
    shui:shapesGraphShape st:prefersMapFacet ;
.

# Mirrors viewers/MapViewer/score.ttl's own geosparql:wktLiteral auto-scoring rules - kept as a
# separate, facet-mode-scoped copy rather than a cross-category reference: getScoringGraph
# (widgets/registry.ts) only ever concatenates one category's own score.ttls per mode, so facet mode
# never sees viewers' scoring rules (and vice versa).
st:mapFacetScore20
    a shui:WidgetScore ;
    shui:widget st:MapFacet ;
    shui:score 20 ;
    shui:dataGraphShape st:mapFacetIsWktLiteral ;
.

st:mapFacetScore10
    a shui:WidgetScore ;
    shui:widget st:MapFacet ;
    shui:score 10 ;
    shui:shapesGraphShape st:mapFacetHasWktDatatypeConstraint ;
.

st:prefersMapFacet
    a sh:NodeShape ;
    sh:property [
        sh:path st:facet ;
        sh:hasValue st:MapFacet ;
    ] ;
.

# A value literal typed as a GeoSPARQL WKT literal - the one direct representation this facet can
# recognize (see geometry.ts's valuesToFeatureCollection).
st:mapFacetIsWktLiteral
    a sh:NodeShape ;
    sh:datatype geosparql:wktLiteral ;
.

# Same signal read off the property shape's own sh:datatype instead of an actual value, so a facet
# with no values yet (an empty dataset) still prefers MapFacet. sh:datatype can, per SHACL 1.2, hold
# a SHACL list of datatypes instead of one IRI (spec issue #1179) - see widget-scoring.ttl's own
# hasCustomDatatype comment for why this needs both branches below.
st:mapFacetHasWktDatatypeConstraint
    a sh:NodeShape ;
    sh:or (
        [
            sh:property [
                sh:path sh:datatype ;
                sh:minCount 1 ;
                sh:hasValue geosparql:wktLiteral ;
            ] ;
        ]
        [
            sh:property [
                sh:path ( sh:datatype [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
                sh:minCount 1 ;
                sh:hasValue geosparql:wktLiteral ;
            ] ;
        ]
    ) ;
.
