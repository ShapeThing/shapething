@prefix ex: <http://example.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix st: <http://shapething.com/>.
@prefix schema: <http://schema.org/>.
@prefix geosparql: <http://www.opengis.net/ont/geosparql#>.

ex:tripShape
    a sh:NodeShape ;
    sh:targetClass ex:Trip ;
    sh:property [
        sh:path schema:name ;
        sh:name "Destination"@en ;
        sh:maxCount 1 ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:path ex:location ;
        sh:name "Location"@en ;
        sh:datatype geosparql:wktLiteral ;
        st:facet st:MapFacet ;
        sh:order 1 ;
    ] ;
    .

# Two European trips, two elsewhere - draw a rectangle roughly over Europe to see Paris/Berlin stay
# while Tokyo/New York drop out (enableFacetOptionCounts, off by default here, would show the live
# count narrowing on the "Location" label itself - see Tests/Facets/Option counts for that in
# isolation).
ex:paris a ex:Trip ;
    schema:name "Paris"@en ;
    ex:location "POINT (2.3522 48.8566)"^^geosparql:wktLiteral .

ex:berlin a ex:Trip ;
    schema:name "Berlin"@en ;
    ex:location "POINT (13.4050 52.5200)"^^geosparql:wktLiteral .

ex:tokyo a ex:Trip ;
    schema:name "Tokyo"@en ;
    ex:location "POINT (139.6917 35.6895)"^^geosparql:wktLiteral .

ex:newYork a ex:Trip ;
    schema:name "New York"@en ;
    ex:location "POINT (-74.0060 40.7128)"^^geosparql:wktLiteral .
