@prefix ex: <http://example.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Product ;
    sh:property [
        sh:name "Price"@en ;
        sh:path schema:price ;
        sh:datatype xsd:decimal ;
    ] ;
    .

<#data> a schema:Product ; schema:name "Widget" ; schema:price 19.99 .
<#product2> a schema:Product ; schema:name "Gadget" ; schema:price 42.50 .
<#product3> a schema:Product ; schema:name "Gizmo" ; schema:price 5.00 .
