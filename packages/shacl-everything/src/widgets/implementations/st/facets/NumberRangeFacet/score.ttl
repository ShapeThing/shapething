PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX st: <http://shapething/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

st:NumberRangeFacet rdfs:label "Number Range"@en, "Getalbereik"@nl .

st:numberRangeFacetScore40
    a shui:WidgetScore ;
    shui:widget st:NumberRangeFacet ;
    shui:score 40 ;
    shui:shapesGraphShape st:prefersNumberRangeFacet ;
.

st:numberRangeFacetScore10
    a shui:WidgetScore ;
    shui:widget st:NumberRangeFacet ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeNumericConstraint ;
.

st:prefersNumberRangeFacet
    a sh:NodeShape ;
    sh:property [
        sh:path st:facet ;
        sh:hasValue st:NumberRangeFacet ;
    ] ;
.
