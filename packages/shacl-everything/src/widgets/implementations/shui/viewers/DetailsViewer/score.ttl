PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:DetailsViewer rdfs:label "Collapsible Section"@en, "Uitklapbare sectie"@nl .

shui:detailsViewerScore0
    a shui:WidgetScore ;
    shui:viewer shui:DetailsViewer ;
    shui:score 0 ;
    shui:dataGraphShape shui:isIRIOrBlankNode ;
.
