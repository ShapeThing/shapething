@prefix ex: <http://example.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.

<#organizationShape>
    a sh:NodeShape ;
    sh:property [
        sh:path rdfs:label ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path schema:industry ;
        shui:propertyRole shui:ClassificationRole ;
    ] .

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:property [
        sh:name "Employer"@en, "Werkgever"@nl ;
        sh:path ex:employer ;
        sh:class schema:Organization ;
        sh:node <#organizationShape> ;
        shui:viewer shui:LabelViewer ;
    ] ;
    .


<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    ex:employer ex:acme ;
    .

ex:acme a schema:Organization ;
    rdfs:label "ACME Corp"@en, "ACME Corp"@nl ;
    schema:industry "Manufacturing"@en, "Productie"@nl .
