PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:HTMLViewer rdfs:label "Rich Text"@en, "Uitgebreide tekst"@nl .

shui:htmlViewerScore20
    a shui:WidgetScore ;
    shui:viewer shui:HTMLViewer ;
    shui:score 20 ;
    shui:dataGraphShape shui:isHTML ;
.
