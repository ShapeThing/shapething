PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:IRIViewer rdfs:label "URI"@en, "URI"@nl .

shui:iriViewerScore30
    a shui:WidgetScore ;
    shui:widget shui:IRIViewer ;
    shui:score 30 ;
    shui:shapesGraphShape shui:prefersIRIViewer ;
.

shui:iriViewerScore1
    a shui:WidgetScore ;
    shui:widget shui:IRIViewer ;
    shui:score 1 ;
    shui:dataGraphShape shui:isIRI ;
.

shui:prefersIRIViewer
    a sh:NodeShape ;
    sh:property [
        sh:path shui:viewer ;
        sh:hasValue shui:IRIViewer ;
    ] ;
.
