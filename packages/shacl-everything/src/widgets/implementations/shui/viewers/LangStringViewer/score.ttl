PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:LangStringViewer rdfs:label "Text with Language"@en, "Tekst met taal"@nl .

shui:langStringViewerScore20
    a shui:WidgetScore ;
    shui:viewer shui:LangStringViewer ;
    shui:score 20 ;
    shui:dataGraphShape shui:isLangString ;
.
