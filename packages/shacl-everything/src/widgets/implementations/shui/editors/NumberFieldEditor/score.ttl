PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:NumberFieldEditor rdfs:label "Number Field"@en, "Getalveld"@nl .

shui:numberFieldEditorScore20
    a shui:WidgetScore ;
    shui:editor shui:NumberFieldEditor ;
    shui:score 20 ;
    shui:dataGraphShape shui:isNumericLiteral ;
.

shui:numberFieldEditorScore10
    a shui:WidgetScore ;
    shui:editor shui:NumberFieldEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeNumericConstraint ;
.
