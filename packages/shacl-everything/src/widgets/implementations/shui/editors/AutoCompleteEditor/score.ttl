PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:AutoCompleteEditor
    a shui:Widget ;
    rdfs:label "Autocomplete"@en, "Automatisch aanvullen"@nl .

shui:autoCompleteEditorScore40
    a shui:WidgetScore ;
    shui:editor shui:AutoCompleteEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:hasClassConstraint ;
.

shui:autoCompleteEditorScore10
    a shui:WidgetScore ;
    shui:editor shui:AutoCompleteEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasNodeKindIRIConstraint, shui:hasClassConstraint ;
.

# spec §10.1: the presence of shui:searchQuery signals a live search widget is appropriate even
# without an explicit shui:editor statement - scored the same as an explicit declaration.
shui:autoCompleteEditorScoreSearchQuery
    a shui:WidgetScore ;
    shui:editor shui:AutoCompleteEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:hasSearchQueryConstraint ;
.

shui:AutoCompleteEditorAcceptMatcher
    a shui:WidgetAcceptMatcher ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:hasNodeKindIRIConstraint ;
    shui:editor shui:AutoCompleteEditor .
