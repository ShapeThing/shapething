PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:DetailsEditor rdfs:label "Nested Form"@en, "Genest formulier"@nl .

shui:detailsEditorScore0
    a shui:WidgetScore ;
    shui:editor shui:DetailsEditor ;
    shui:score 0 ;
    shui:dataGraphShape shui:isIRIOrBlankNode ;
.
