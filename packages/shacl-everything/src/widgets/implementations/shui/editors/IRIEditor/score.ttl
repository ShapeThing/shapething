PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:IRIEditor rdfs:label "IRI Field"@en, "IRI-veld"@nl .

shui:iriEditorScore20
    a shui:WidgetScore ;
    shui:editor shui:IRIEditor ;
    shui:score 20 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:hasNodeKindIRIConstraint, shui:hasNoClassConstraint ;
.

shui:iriEditorScore10
    a shui:WidgetScore ;
    shui:editor shui:IRIEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasNodeKindIRIConstraint, shui:hasNoClassConstraint ;
.

shui:iriEditorScore0
    a shui:WidgetScore ;
    shui:editor shui:IRIEditor ;
    shui:score 0 ;
    shui:dataGraphShape shui:isIRI ;
.
