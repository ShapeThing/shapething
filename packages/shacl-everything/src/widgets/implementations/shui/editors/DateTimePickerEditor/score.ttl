PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:DateTimePickerEditor rdfs:label "Date & Time Picker"@en, "Datum- en tijdkiezer"@nl .

shui:dateTimePickerEditorScore20
    a shui:WidgetScore ;
    shui:editor shui:DateTimePickerEditor ;
    shui:score 20 ;
    shui:dataGraphShape shui:isDateTime ;
.

shui:dateTimePickerEditorScore10
    a shui:WidgetScore ;
    shui:editor shui:DateTimePickerEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeDateTimeConstraint ;
.
