PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:InstancesSelectEditor rdfs:label "Instance Picker"@en, "Instantiekiezer"@nl .

shui:instancesSelectEditorScore40
    a shui:WidgetScore ;
    shui:editor shui:InstancesSelectEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:hasClassConstraint ;
.

shui:instancesSelectEditorScore0
    a shui:WidgetScore ;
    shui:editor shui:InstancesSelectEditor ;
    shui:score 0 ;
    shui:shapesGraphShape shui:hasClassConstraint ;
.
