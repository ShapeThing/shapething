PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:EnumSelectEditor rdfs:label "Dropdown"@en, "Keuzelijst"@nl .

shui:enumSelectEditorScore30
    a shui:WidgetScore ;
    shui:editor shui:EnumSelectEditor ;
    shui:score 30 ;
    shui:shapesGraphShape shui:hasInConstraint ;
.

# sh:class without sh:in (e.g. a small controlled vocabulary enumerated by rdf:type rather than
# spelled out via sh:in) - see widget.tsx's classOptions fallback. Scored the same tier (40) as
# AutoCompleteEditor/InstancesSelectEditor's own hasClassConstraint rules, so all three tie for a
# bare sh:class constraint.
shui:enumSelectEditorScore40Class
    a shui:WidgetScore ;
    shui:editor shui:EnumSelectEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:hasClassConstraint ;
.

shui:enumSelectEditorScore0Class
    a shui:WidgetScore ;
    shui:editor shui:EnumSelectEditor ;
    shui:score 0 ;
    shui:shapesGraphShape shui:hasClassConstraint ;
.
