PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:SubClassEditor rdfs:label "Class Picker"@en, "Klassekiezer"@nl .

shui:subClassEditorScore40
    a shui:WidgetScore ;
    shui:editor shui:SubClassEditor ;
    shui:score 40 ;
    shui:dataGraphShape shui:isIRI ;
    shui:shapesGraphShape shui:hasRootClassConstraint ;
.
