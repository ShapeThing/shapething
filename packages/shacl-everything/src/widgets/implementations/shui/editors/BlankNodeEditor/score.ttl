PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:BlankNodeEditor rdfs:label "Nested Fields"@en, "Geneste velden"@nl .

shui:blankNodeEditorScore40
    a shui:WidgetScore ;
    shui:widget shui:BlankNodeEditor ;
    shui:score 40 ;
    # isIRIOrBlankNode, not isBlankNode: an explicit shui:editor preference for this widget must
    # keep winning once its own "change nested node to node with identifier" button has turned
    # the value from a blank node into a NamedNode - otherwise the nested sub-form it was showing
    # would vanish behind whichever plain IRI widget scores next.
    shui:dataGraphShape shui:isIRIOrBlankNode ;
    shui:shapesGraphShape shui:prefersBlankNodeEditor ;
.

shui:blankNodeEditorScore1
    a shui:WidgetScore ;
    shui:widget shui:BlankNodeEditor ;
    shui:score 1 ;
    shui:dataGraphShape shui:isBlankNode ;
.

shui:prefersBlankNodeEditor
    a sh:NodeShape ;
    sh:property [
        sh:path shui:editor ;
        sh:hasValue shui:BlankNodeEditor ;
    ] ;
.
