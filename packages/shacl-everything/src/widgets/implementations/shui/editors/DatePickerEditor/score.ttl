PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:DatePickerEditor rdfs:label "Date Picker"@en, "Datumkiezer"@nl .

shui:datePickerEditorScore20
    a shui:WidgetScore ;
    shui:editor shui:DatePickerEditor ;
    shui:score 30 ;
    shui:dataGraphShape shui:isDate ;
.

shui:datePickerEditorScore10
    a shui:WidgetScore ;
    shui:editor shui:DatePickerEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeDateConstraint ;
.
