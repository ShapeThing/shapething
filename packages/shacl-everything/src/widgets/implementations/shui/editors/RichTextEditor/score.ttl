PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:RichTextEditor rdfs:label "Rich Text"@en, "Uitgebreide tekst"@nl .

shui:richTextEditorScore20
    a shui:WidgetScore ;
    shui:editor shui:RichTextEditor ;
    shui:score 20 ;
    shui:dataGraphShape shui:isHTML ;
.

shui:richTextEditorScore10
    a shui:WidgetScore ;
    shui:editor shui:RichTextEditor ;
    shui:score 10 ;
    shui:shapesGraphShape shui:hasDatatypeHTMLConstraint ;
.
