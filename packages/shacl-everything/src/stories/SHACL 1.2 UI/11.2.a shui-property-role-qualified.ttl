@prefix ex: <http://example.org/>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:property [
        sh:name "Employer"@en, "Werkgever"@nl ;
        sh:path schema:worksFor ;
        sh:class schema:Organization ;
        sh:nodeKind sh:IRI ;
        sh:node [
            sh:property ex:PrefLabel, ex:Name ;
        ] ;
    ] ;
    .

ex:PrefLabel a sh:PropertyShape ;
    sh:path skos:prefLabel ;
    shui:propertyRole [
        shui:propertyRole shui:LabelRole ;
        sh:order 0 ;
    ] ;
    .

ex:Name a sh:PropertyShape ;
    sh:path schema:name ;
    shui:propertyRole [
        shui:propertyRole shui:LabelRole ;
        sh:order 1 ;
    ] ;
    .


<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    schema:worksFor ex:acme ;
    .

ex:acme a schema:Organization ;
    skos:prefLabel "Acme Corporation"@en ;
    schema:name "Acme Corp"@en ;
    .
