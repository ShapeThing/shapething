@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix ex: <http://example.org/>.

# A deliberately minimal skos:Concept shape, showing just the two things this demo is about: a
# local shui:AutoCompleteEditor field (skos:inScheme, searching skos:ConceptScheme instances
# already present in the local dataGraph) and a federated one (skos:topConceptOf, searching the
# real TOOI thesaurus over SPARQL - the same public endpoint skos-ap-nl-tooi-federation.ttl
# federates skos:Concept lookups against). skos:ConceptScheme is labelled via rdfs:label in both -
# unlike skos:Concept, which SKOS labels via skos:prefLabel - so the LabelRole below points at
# rdfs:label rather than mirroring 11.3.1 shui-label-role.ttl's skos:prefLabel.

<#conceptSchemeLabelShape>
  a sh:NodeShape ;
  sh:property [
    sh:path rdfs:label ;
    shui:propertyRole shui:LabelRole ;
  ] .

<#shape>
  a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:property [
    sh:name "In scheme (local)"@en, "In begrippenkader (lokaal)"@nl ;
    sh:path skos:inScheme ;
    sh:class skos:ConceptScheme ;
    sh:nodeKind sh:IRI ;
    sh:node <#conceptSchemeLabelShape> ;
    shui:editor shui:AutoCompleteEditor ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:name "Top concept of (federated, TOOI)"@en, "Topbegrip van (gefedereerd, TOOI)"@nl ;
    sh:path skos:topConceptOf ;
    sh:class skos:ConceptScheme ;
    sh:nodeKind sh:IRI ;
    sh:node <#conceptSchemeLabelShape> ;
    shui:editor shui:AutoCompleteEditor ;
    # shui:searchQuery drives as-you-type search; sh:in's sh:select is the Dynamic-SHACL fallback
    # for a renderer that doesn't support shui:searchQuery (spec §10.1) - mirrors
    # skos-ap-nl-tooi-federation.ttl's own Concept-*-TooiFederated shapes, except querying
    # rdfs:label rather than skos:prefLabel/skos:altLabel, since TOOI labels its ConceptSchemes
    # (thesauri) that way, not with SKOS lexical labels.
    shui:searchQuery """
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
      SELECT DISTINCT ?value WHERE {
        SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
          ?value a skos:ConceptScheme ;
            rdfs:label ?searchLabel .
          BIND(IF(CONTAINS($uiLanguage, "-"), STRBEFORE($uiLanguage, "-"), $uiLanguage) AS ?uiPrimaryLanguage)
          FILTER(LANGMATCHES(LANG(?searchLabel), ?uiPrimaryLanguage))
          FILTER(CONTAINS(LCASE(?searchLabel), LCASE($searchTerm)))
        }
      }
    """ ;
    sh:in [
      sh:select """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT DISTINCT ?value1 WHERE {
          SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
            ?value1 a skos:ConceptScheme .
          }
        }
        LIMIT 100
      """ ;
    ] ;
    sh:order 2 ;
  ] .

<#data>
  a skos:Concept ;
  skos:prefLabel "Fiets"@nl, "Bicycle"@en ;
  skos:inScheme ex:transportScheme ;
  # A real TOOI ConceptScheme (https://identifier.overheid.nl/tooi/def/thes/upl/Bestuurslagen,
  # rdfs:label "Bestuurslagen"@nl - TOOI only labels its schemes in Dutch) - already linked so its
  # label resolves live against the federated endpoint on load, with no search interaction needed.
  skos:topConceptOf <https://identifier.overheid.nl/tooi/def/thes/upl/Bestuurslagen> .

ex:transportScheme a skos:ConceptScheme ; rdfs:label "Vervoermiddelen"@nl, "Means of transport"@en .
ex:animalsScheme a skos:ConceptScheme ; rdfs:label "Dieren"@nl, "Animals"@en .
ex:foodScheme a skos:ConceptScheme ; rdfs:label "Voedsel"@nl, "Food"@en .
