@prefix ex: <http://example.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dbo: <http://dbpedia.org/ontology/>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:property [
        sh:name "Favourite philosopher"@en, "Favoriete filosoof"@nl ;
        sh:path ex:favouritePhilosopher ;
        sh:class dbo:Philosopher ;
        sh:nodeKind sh:IRI ;
        sh:node <#philosopherShape> ;
        shui:editor shui:AutoCompleteEditor ;
        sh:in [
            # shui:searchQuery lets this shape hand a fulltext search straight to the renderer
            # instead of relying on its default IRI/LabelRole substring search (which can only ever
            # see already-loaded local data). This deliberately uses a plain CONTAINS/LCASE filter
            # rather than Virtuoso's bif:contains fulltext-index predicate: bif:contains is a
            # syntax-level magic predicate that Virtuoso only recognizes when the query text itself
            # says `bif:contains` - but Comunica parses this query into SPARQL algebra and
            # re-serializes it before sending it over SERVICE, which normalizes `bif:contains` into
            # its resolved-IRI form `<bif:contains>` and silently defeats the magic predicate (it
            # then matches literally nothing, since no real triple has that predicate). CONTAINS/
            # LCASE are standard SPARQL 1.1, survive that round trip unchanged, and work against any
            # endpoint - not just Virtuoso.
            # ?searchTerm/?uiLanguage are substituted by the renderer at execution time; the LIMIT the
            # spec forbids here is added by the renderer instead (see query.ts).
            shui:searchQuery """
                PREFIX dbo: <http://dbpedia.org/ontology/>
                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                SELECT distinct ?value WHERE {
                    SERVICE <https://dbpedia.org/sparql> {
                        ?value a dbo:Philosopher .
                        ?value rdfs:label ?searchLabel .
                        FILTER(CONTAINS(LCASE(?searchLabel), LCASE(?searchTerm)))
                        # dbpedia tags its plain-language labels with a bare primary subtag ("en"),
                        # not a full BCP47 tag ("en-GB") - LANGMATCHES only matches when the label's
                        # tag is at least as specific as the range, so matching against the full
                        # ?uiLanguage as-is would reject every bare-tagged label. Truncate to the
                        # primary subtag first (falling back to ?uiLanguage itself when it has none).
                        BIND(IF(CONTAINS(?uiLanguage, "-"), STRBEFORE(?uiLanguage, "-"), ?uiLanguage) AS ?uiPrimaryLanguage)
                        FILTER(LANGMATCHES(lang(?searchLabel), ?uiPrimaryLanguage))
                    }
                }
            """
        ] ;
    ] ;
    .

<#philosopherShape>
    sh:property [
        sh:path rdfs:label ;
        shui:propertyRole shui:LabelRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        shui:propertyRole shui:SubLabelRole ;
        sh:order 2 ;
    ] ;
    sh:property [
        sh:path dbo:thumbnail ;
        shui:propertyRole shui:DepictionRole ;
        sh:order 3 ;
    ] .

<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    ex:favouritePhilosopher <http://dbpedia.org/resource/Aristotle> ;
    .
