@prefix ex: <http://example.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dbo: <http://dbpedia.org/ontology/>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:property [
        sh:name "Favourite philosopher"@en, "Favoriete filosoof"@nl ;
        sh:path ex:favouritePhilosopher ;
        sh:class dbo:Philosopher ;
        sh:nodeKind sh:IRI ;
        sh:node <#philosopherShape> ;
        shui:editor shui:AutoCompleteEditor ;
        # shui:searchQuery is asserted directly on the property shape (spec §10.1), independent of
        # sh:in below - it's what the AutoCompleteEditor actually queries as the user types.
        shui:searchQuery """
            PREFIX dbo: <http://dbpedia.org/ontology/>
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT distinct ?value WHERE {
                SERVICE <https://dbpedia.org/sparql> {
                    ?value a dbo:Philosopher .
                    ?value rdfs:label ?searchLabel .
                    FILTER(CONTAINS(LCASE(?searchLabel), LCASE($searchTerm)))
                    BIND(IF(CONTAINS($uiLanguage, "-"), STRBEFORE($uiLanguage, "-"), $uiLanguage) AS ?uiPrimaryLanguage)
                    FILTER(LANGMATCHES(lang(?searchLabel), ?uiPrimaryLanguage))
                }
            }
        """ ;
        sh:in [
            # The baseline/fallback query (spec §10.1): used instead of shui:searchQuery only by a
            # renderer that doesn't support shui:searchQuery but does support Dynamic SHACL.
            sh:select """
                PREFIX dbo: <http://dbpedia.org/ontology/>
                SELECT DISTINCT ?value1 WHERE {
                    SERVICE <https://dbpedia.org/sparql> {
                        ?value1 a dbo:Philosopher .
                    }
                }
            """ ;
        ] ;
    ] ;
    .

<#philosopherShape>
    sh:property [
        sh:path rdfs:label ;
        shui:propertyRole shui:LabelRole ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        shui:propertyRole shui:SubLabelRole ;
        sh:order 2 ;
    ] ;
    sh:property [
        sh:path dbo:thumbnail ;
        shui:propertyRole shui:DepictionRole ;
        sh:order 3 ;
    ] .

<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    ex:favouritePhilosopher <http://dbpedia.org/resource/Aristotle> ;
    .
