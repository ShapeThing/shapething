@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix ex: <http://example.org/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:or (
        [
            sh:name "As free text"@en ;

            sh:property [
                sh:name "Address"@en ;
                sh:path schema:address ;
                sh:datatype xsd:string ;
                sh:singleLine false ;
                sh:minCount 1 ;
            ] ;
        ]
        [
            sh:name "As structured fields"@en ;
            sh:node [
                sh:property [
                    sh:name "Street"@en ;
                    sh:path schema:streetAddress ;
                    sh:datatype xsd:string ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                ] ;
                sh:property [
                    sh:name "House number"@en ;
                    sh:path ex:houseNumber ;
                    sh:datatype xsd:string ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                ] ;
                sh:property [
                    sh:name "Postal code"@en ;
                    sh:path schema:postalCode ;
                    sh:datatype xsd:string ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                ] ;
                sh:property [
                    sh:name "City"@en ;
                    sh:path schema:addressLocality ;
                    sh:datatype xsd:string ;
                    sh:minCount 1 ;
                    sh:maxCount 1 ;
                ] ;
            ] ;
        ]
    ) ;

    .


<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    schema:streetAddress "Dam" ;
    ex:houseNumber "1" ;
    schema:postalCode "1012 AB" ;
    schema:addressLocality "Amsterdam" ;
    .
