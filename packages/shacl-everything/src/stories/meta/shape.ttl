@prefix schema: <http://schema.org/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix dc: <http://purl.org/dc/elements/1.1/>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix st: <http://shapething.com/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass sh:Shape ;

    owl:imports sh: ;

    sh:property [
        sh:name "Title"@en, "Titel"@nl ;
        sh:order -100 ;
        sh:path [ sh:alternativePath (sh:name rdfs:label ) ] ;
        sh:uniqueLang true ;
        # sh:group <#metadata> ;
        sh:datatype ( xsd:string rdf:langString ) ;
    ] ;

    sh:property [
        sh:order -99 ;
        sh:name "Description"@en, "Beschrijving"@nl ;
        sh:path [ sh:alternativePath (sh:description rdfs:comment ) ] ;
        # sh:group <#metadata> ;
        sh:uniqueLang true ;
        sh:singleLine false ;
        sh:datatype ( xsd:string rdf:langString ) ;
    ] ;

    sh:property [
        sh:order 3 ;
        sh:name "Severity"@en, "Ernst"@nl ;
        sh:path sh:severity ;
        shui:editor shui:EnumSelectEditor ;
        sh:group <#metadata> ;
        sh:class sh:Severity ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:order 4 ;
        sh:name "Imports"@en, "Imports"@nl ;
        sh:path owl:imports ;
        sh:group <#metadata> ;
        sh:nodeKind sh:IRI ;
        sh:class owl:Ontology ;
        st:suggestedValues (
            owl:
            skos:
            schema:
        ) ;
    ] ;

    sh:property [
        sh:order 6 ;
        sh:name "Order"@en, "Volgorde"@nl ;
        sh:path sh:order ;
        sh:maxCount 1 ;
        sh:group <#metadata> ;
        sh:datatype xsd:integer ;
    ] ;


    .

<#nodeShape>
    a sh:NodeShape ;
    sh:targetClass sh:NodeShape ;

    sh:name "Shape"@en, "Vorm"@nl ;
    sh:description "A shape defines the structure and constraints for RDF nodes."@en, "Een vorm definieert de structuur en beperkingen voor RDF-knopen."@nl ;

    sh:node <#shape> ;

    sh:property [
        sh:order -98 ;
        sh:name "Properties"@en, "Eigenschappen"@nl ;
        sh:path sh:property ;
        # sh:group <#properties> ;
        sh:nodeKind ( sh:IRI sh:BlankNode ) ;
        st:orderBy sh:order ;
    ] ;

    sh:property [
        sh:order 3 ;
        sh:name "Class based"@en, "Klasse gebaseerd"@nl ;
        sh:path sh:targetClass ;
        sh:group <#targetingInner> ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:order 4 ;
        sh:name "Node based"@en, "Knoop gebaseerd"@nl ;
        sh:path sh:targetNode ;
        sh:group <#targetingInner> ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:order 5 ;
        sh:name "Objects of"@en, "Objecten van"@nl ;
        sh:path sh:targetObjectsOf ;
        sh:group <#targetingInner> ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:order 6 ;
        sh:name "Subjects of"@en, "Subjecten van"@nl ;
        sh:path sh:targetSubjectsOf ;
        sh:group <#targetingInner> ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:order 7 ;
        sh:name "Node"@en, "Knoop"@nl ;
        sh:path sh:node ;
        sh:group <#nodeConstraintsInner> ;
        sh:nodeKind (sh:IRI sh:BlankNode) ;
    ] ;

    sh:property [
        sh:order 3 ;
        sh:name "Sparql based constraints"@en, "Sparql gebaseerde beperkingen"@nl ;
        sh:path sh:sparql ;
        sh:group <#nodeConstraints> ;
        sh:class sh:SPARQLConstraint ;
    ] ;

    sh:property [
        sh:order 8 ;
        sh:name "Ignored properties"@en, "Genegeerde eigenschappen"@nl ;
        sh:path sh:ignoredProperties ;
        sh:group <#nodeConstraintsInner> ;
        sh:nodeKind sh:IRI ;
        sh:class sh:PropertyShape ;
    ] ;

    .

<#propertyShape>
    a sh:NodeShape ;
    sh:targetClass sh:PropertyShape ;

    sh:name "Property shape"@en, "Property vorm"@nl ;
    sh:description "A property shape defines the constraints for one property (its sh:path) of a node."@en, "Een property vorm definieert de beperkingen voor één eigenschap (het sh:path) van een knoop."@nl ;

    sh:node <#shape> ;

    sh:property [
        sh:order 3 ;
        sh:name "Path"@en, "Pad"@nl ;
        sh:path sh:path ;
        sh:order -96;
        # sh:group <#propertyConstraintsInner> ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:order -95 ;
        sh:name "Editor"@en, "Editor"@nl ;
        sh:path shui:editor ;
        shui:editor shui:EnumSelectEditor ;
        sh:group <#propertyConstraintsInner> ;
        sh:class shui:Editor ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;

    # sh:minCount and sh:maxCount share <#cardinality>, whose st:CardinalityPropertyGroup shows them
    # as "Required" / "Multiple" checkboxes, with these two fields in its "Advanced" section.
    sh:property [
        sh:order 0 ;
        sh:name "Minimum count"@en, "Minimum aantal"@nl ;
        sh:path sh:minCount ;
        sh:group <#cardinality> ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] ;

    sh:property [
        sh:order 1 ;
        sh:name "Maximum count"@en, "Maximum aantal"@nl ;
        sh:path sh:maxCount ;
        sh:group <#cardinality> ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] ;

    sh:property [
        sh:order -80 ;
        sh:name "Datatype"@en, "Datatype"@nl ;
        sh:path sh:datatype ;
        # sh:group <#propertyConstraintsInner> ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:order 7 ;
        sh:name "Class"@en, "Klasse"@nl ;
        sh:path sh:class ;
        sh:group <#propertyConstraintsInner> ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:order 8 ;
        sh:name "Node kind"@en, "Node kind"@nl ;
        sh:path sh:nodeKind ;
        sh:group <#propertyConstraintsInner> ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:in ( sh:IRI sh:BlankNode sh:Literal sh:BlankNodeOrIRI sh:BlankNodeOrLiteral sh:IRIOrLiteral ) ;
    ] ;

    sh:property [
        sh:order 9 ;
        sh:name "Group"@en, "Groep"@nl ;
        sh:path sh:group ;
        sh:class sh:PropertyGroup ;
        sh:group <#propertyConstraintsInner> ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:order 10 ;
        sh:name "Node"@en, "Knoop"@nl ;
        sh:path sh:node ;
        sh:group <#propertyConstraintsInner> ;
        sh:nodeKind (sh:IRI sh:BlankNode) ;
    ] ;


    sh:property [
        sh:order 11 ;
        sh:name "Disjoint"@en, "Disjunct"@nl ;
        sh:path sh:disjoint ;
        sh:group <#propertyConstraintsInner> ;
        sh:nodeKind (sh:IRI sh:BlankNode) ;
    ] ;

    sh:property [
        sh:order 12 ;
        sh:name "Or"@en, "Of"@nl ;
        sh:path sh:or ;
        sh:group <#propertyConstraintsInner> ;
        sh:nodeKind (sh:IRI sh:BlankNode) ;
    ] ;

    sh:property [
        sh:order 13 ;
        sh:name "And"@en, "En"@nl ;
        sh:path sh:and ;
        sh:group <#propertyConstraintsInner> ;
        sh:nodeKind (sh:IRI sh:BlankNode) ;
    ] ;

    sh:property [
        sh:order 14 ;
        sh:name "Not"@en, "Niet"@nl ;
        sh:path sh:not ;
        sh:group <#propertyConstraintsInner> ;
        sh:nodeKind (sh:IRI sh:BlankNode) ;
    ] ;

    sh:property [
        sh:order 1 ;
        sh:name "Allowed values"@en, "Toegestane waarden"@nl ;
        sh:description "The only values this property may have."@en, "De enige waarden die deze eigenschap mag hebben."@nl ;
        sh:path sh:in ;
        sh:group <#valueConstraintsInner> ;
        sh:maxCount 1 ;
        sh:memberShape [
            sh:or (
                [ sh:datatype xsd:string ]
                [ sh:nodeKind sh:IRI ]
            ) ;
        ] ;
    ] ;

    sh:property [
        sh:order 2 ;
        sh:name "Pattern"@en, "Patroon"@nl ;
        sh:description "A regular expression every value must match."@en, "Een reguliere expressie waar elke waarde aan moet voldoen."@nl ;
        sh:path sh:pattern ;
        sh:group <#valueConstraintsInner> ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:order 3 ;
        sh:name "Minimum length"@en, "Minimale lengte"@nl ;
        sh:path sh:minLength ;
        sh:group <#valueConstraintsInner> ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
    ] ;

    sh:property [
        sh:order 4 ;
        sh:name "Maximum length"@en, "Maximale lengte"@nl ;
        sh:path sh:maxLength ;
        sh:group <#valueConstraintsInner> ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
    ] ;

    sh:property [
        sh:order 5 ;
        sh:name "Unique language"@en, "Unieke taal"@nl ;
        sh:description "At most one value per language."@en, "Hoogstens één waarde per taal."@nl ;
        sh:path sh:uniqueLang ;
        sh:group <#valueConstraintsInner> ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
    ] ;

    sh:property [
        sh:order 6 ;
        sh:name "Allowed languages"@en, "Toegestane talen"@nl ;
        sh:path sh:languageIn ;
        sh:group <#valueConstraintsInner> ;
        sh:maxCount 1 ;
        sh:memberShape [
            sh:datatype xsd:string ;
        ] ;
    ] ;

    .

# An editor's classification is the ontology it is defined by (shui: or st:, see each editor's
# score.ttl), shown by that ontology's own rdfs:label.
<#editor>
    a sh:NodeShape ;
    sh:targetClass shui:Editor ;

    sh:property [
        sh:name "Defined by"@en, "Gedefinieerd door"@nl ;
        sh:path rdfs:isDefinedBy ;
        shui:propertyRole shui:ClassificationRole ;
    ] ;

    .

shui:
    rdfs:label "SHACL UI"@en, "SHACL UI"@nl .

st:
    rdfs:label "ShapeThing"@en, "ShapeThing"@nl .

<#propertyGroup>
    a sh:NodeShape ;
    sh:targetClass sh:PropertyGroup ;

    sh:name "Group"@en, "Groep"@nl ;
    sh:description "A group shows properties together, in the order of its own sh:order among its siblings."@en, "Een groep toont eigenschappen samen, op de plek van zijn eigen sh:order tussen zijn buren."@nl ;

    sh:property [
        sh:order 0 ;
        sh:name "Name"@en, "Naam"@nl ;
        sh:path [ sh:alternativePath ( rdfs:label sh:name ) ] ;
        sh:uniqueLang true ;
        sh:datatype ( xsd:string rdf:langString ) ;
    ] ;

    sh:property [
        sh:order 1 ;
        sh:name "Type"@en, "Type"@nl ;
        sh:path rdf:type ;
        shui:editor shui:EnumSelectEditor ;
        sh:in (
            sh:PropertyGroup
            st:TabbedPropertyGroup
            st:VerticalTabbedPropertyGroup
            st:HorizontalPropertyGroup
            st:CollapsiblePropertyGroup
            st:DrawerPropertyGroup
            st:CardinalityPropertyGroup
        ) ;
    ] ;


    sh:property [
        sh:order 2 ;
        sh:name "Description"@en, "Beschrijving"@nl ;
        sh:path [ sh:alternativePath ( sh:description rdfs:comment ) ] ;
        sh:uniqueLang true ;
        sh:datatype ( xsd:string rdf:langString ) ;
    ] ;

    sh:property [
        sh:order 3 ;
        sh:name "Order"@en, "Volgorde"@nl ;
        sh:path sh:order ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
    ] ;

    sh:property [
        sh:order 4 ;
        sh:name "Group"@en, "Groep"@nl ;
        sh:description "The group this group is shown in."@en, "De groep waarin deze groep getoond wordt."@nl ;
        sh:path sh:group ;
        sh:class sh:PropertyGroup ;
        sh:maxCount 1 ;
    ] ;

    .

sh:IRI rdfs:label "IRI"@en, "IRI"@nl .
sh:BlankNode rdfs:label "Blank node"@en, "Blanco node"@nl .
sh:Literal rdfs:label "Literal"@en, "Literal"@nl .
sh:BlankNodeOrIRI rdfs:label "Blank node or IRI"@en, "Blanco node of IRI"@nl .
sh:BlankNodeOrLiteral rdfs:label "Blank node or literal"@en, "Blanco node of literal"@nl .
sh:IRIOrLiteral rdfs:label "IRI or literal"@en, "IRI of literal"@nl .

sh:PropertyGroup rdfs:label "Group"@en, "Groep"@nl .
st:TabbedPropertyGroup rdfs:label "Tabs"@en, "Tabbladen"@nl .
st:VerticalTabbedPropertyGroup rdfs:label "Vertical tabs"@en, "Verticale tabbladen"@nl .
st:HorizontalPropertyGroup rdfs:label "Horizontal"@en, "Horizontaal"@nl .
st:CollapsiblePropertyGroup rdfs:label "Collapsible"@en, "Inklapbaar"@nl .
st:DrawerPropertyGroup rdfs:label "Drawer"@en, "Lade"@nl .
st:CardinalityPropertyGroup rdfs:label "Cardinality"@en, "Kardinaliteit"@nl .

<#metadata>
    a sh:PropertyGroup, st:VerticalTabbedPropertyGroup ;
    sh:name "Metadata"@en, "Metadata"@nl ;
    sh:order 1 ;
    st:icon "iconmind:tag-outline-thin"^^<https://iconify.design> ;
    st:color [
        st:hue "17.2192513368984"^^xsd:decimal ;
        st:saturation "91.21951219512198"^^xsd:decimal ;
        st:lightness "59.80392156862745"^^xsd:decimal ;
    ] ;
    sh:description "Metadata for the shape."@en, "Metadata voor de vorm."@nl ;
    .


<#targeting>
    a sh:PropertyGroup, st:VerticalTabbedPropertyGroup ;
    sh:name "Targeting"@en, "Targeting"@nl ;
    sh:order 2 ;
    st:icon "iconmind:goal-outline-thin"^^<https://iconify.design> ;
    st:color [
        st:hue "117.2192513368984"^^xsd:decimal ;
        st:saturation "91.21951219512198"^^xsd:decimal ;
        st:lightness "59.80392156862745"^^xsd:decimal ;
    ] ;
    sh:description "Targeting for the shape."@en, "Doelselectie van de vorm."@nl ;
    .


<#targetingInner>
    a sh:PropertyGroup, st:DrawerPropertyGroup ;
    sh:order 1000 ;
    sh:group <#targeting> ;
    .

<#nodeConstraints>
    a sh:PropertyGroup, st:VerticalTabbedPropertyGroup ;
    sh:name "Node constraints"@en, "Knoop beperkingen"@nl ;
    sh:order 3 ;
    st:color [
        st:hue "217.2192513368984"^^xsd:decimal ;
        st:saturation "91.21951219512198"^^xsd:decimal ;
        st:lightness "59.80392156862745"^^xsd:decimal ;
    ] ;
    st:icon "iconmind:list-checks-outline-thin"^^<https://iconify.design> ;
    sh:description "Constraints for the node shape."@en, "Beperkingen van de knoopvorm."@nl ;
    .


<#nodeConstraintsInner>
    a sh:PropertyGroup, st:DrawerPropertyGroup ;
    sh:order 1000 ;
    sh:group <#nodeConstraints> ;
    .

<#propertyConstraints>
    a sh:PropertyGroup, st:VerticalTabbedPropertyGroup ;
    sh:name "Property constraints"@en, "Eigenschap beperkingen"@nl ;
    sh:order 3 ;
    st:color [
        st:hue "217.2192513368984"^^xsd:decimal ;
        st:saturation "91.21951219512198"^^xsd:decimal ;
        st:lightness "59.80392156862745"^^xsd:decimal ;
    ] ;
    st:icon "iconmind:list-checks-outline-thin"^^<https://iconify.design> ;
    sh:description "Constraints for the property shape."@en, "Beperkingen van de eigenschapsvorm."@nl ;
    .


<#cardinality>
    a sh:PropertyGroup, st:CardinalityPropertyGroup ;
    sh:name "Cardinality"@en, "Kardinaliteit"@nl ;
    sh:order -91 ;
    .

<#propertyConstraintsInner>
    a sh:PropertyGroup, st:DrawerPropertyGroup ;
    sh:order 1000 ;
    sh:group <#propertyConstraints> ;
    .

<#valueConstraints>
    a sh:PropertyGroup, st:VerticalTabbedPropertyGroup ;
    sh:name "Value constraints"@en, "Waardebeperkingen"@nl ;
    sh:order 4 ;
    st:color [
        st:hue "287.2192513368984"^^xsd:decimal ;
        st:saturation "91.21951219512198"^^xsd:decimal ;
        st:lightness "59.80392156862745"^^xsd:decimal ;
    ] ;
    st:icon "iconmind:filter-outline-thin"^^<https://iconify.design> ;
    sh:description "Constraints every value of the property must meet."@en, "Beperkingen waar elke waarde van de eigenschap aan moet voldoen."@nl ;
    .

<#valueConstraintsInner>
    a sh:PropertyGroup, st:DrawerPropertyGroup ;
    sh:order 1000 ;
    sh:group <#valueConstraints> ;
    .

<#properties>
    a sh:PropertyGroup, st:VerticalTabbedPropertyGroup ;
    sh:name "Properties"@en, "Eigenschappen"@nl ;
    sh:order 5 ;
    st:color [
        st:hue "67.2192513368984"^^xsd:decimal ;
        st:saturation "91.21951219512198"^^xsd:decimal ;
        st:lightness "59.80392156862745"^^xsd:decimal ;
    ] ;
    st:icon "iconmind:dean-list-outline-thin"^^<https://iconify.design> ;
    sh:description "Properties for the shape."@en, "Eigenschappen van de vorm."@nl ;
    .