skosapnl:Concept-topConceptOf-TooiFederated
  a sh:PropertyShape ;
  sh:path skos:topConceptOf ;
  sh:node skosapnl:TooiConceptSchemeLabelShape ;
  shui:editor shui:AutoCompleteEditor ;
  shui:searchQuery """
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT DISTINCT ?value WHERE {
      SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
        ?value a skos:ConceptScheme ;
          skos:prefLabel ?searchLabel .
        BIND(IF(CONTAINS($uiLanguage, "-"), STRBEFORE($uiLanguage, "-"), $uiLanguage) AS ?uiPrimaryLanguage)
        FILTER(LANGMATCHES(LANG(?searchLabel), ?uiPrimaryLanguage))
        FILTER(CONTAINS(LCASE(?searchLabel), LCASE($searchTerm)))
      }
    }
  """ ;
  sh:in [
    sh:select """
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT DISTINCT ?value1 WHERE {
        SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
          ?value1 a skos:ConceptScheme .
        }
      }
      LIMIT 100
    """ ;
  ] .

skosapnl:ConceptScheme-hasTopConcept-TooiFederated
  a sh:PropertyShape ;
  sh:path skos:hasTopConcept ;
  sh:node skosapnl:TooiConceptLabelShape ;
  shui:editor shui:AutoCompleteEditor ;
  shui:searchQuery """
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT DISTINCT ?value WHERE {
      SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
        ?value a skos:Concept ;
          (skos:prefLabel|skos:altLabel) ?searchLabel .
        BIND(IF(CONTAINS($uiLanguage, "-"), STRBEFORE($uiLanguage, "-"), $uiLanguage) AS ?uiPrimaryLanguage)
        FILTER(LANGMATCHES(LANG(?searchLabel), ?uiPrimaryLanguage))
        FILTER(CONTAINS(LCASE(?searchLabel), LCASE($searchTerm)))
      }
    }
  """ ;
  sh:in [
    sh:select """
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT DISTINCT ?value1 WHERE {
        SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
          ?value1 a skos:Concept .
        }
      }
      LIMIT 100
    """ ;
  ] .

skosapnl:Concept sh:property
  skosapnl:Concept-related-TooiFederated ,
  skosapnl:Concept-broader-TooiFederated ,
  skosapnl:Concept-narrower-TooiFederated ,
  skosapnl:Concept-topConceptOf-TooiFederated .

skosapnl:ConceptScheme sh:property skosapnl:ConceptScheme-hasTopConcept-TooiFederated .
