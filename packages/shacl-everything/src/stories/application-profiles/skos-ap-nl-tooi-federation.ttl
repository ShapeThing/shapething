@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shui: <http://www.w3.org/ns/shacl-ui/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosapnl: <http://nlbegrip.nl/def/skosapnl#> .
@prefix isothes: <http://purl.org/iso25964/skos-thes#> .

# Augments skos-ap-nl.ttl (loaded alongside it, never edited in place - see nl-sbb.stories.tsx)
# with federated search for the "Harmonisatierelaties"/Matching Relationships group, against the
# TOOI thesaurus (Thesaurus en Ontologie Overheidsinformatie,
# https://standaarden.overheid.nl/tooi), a real NL-SBB/SKOS-AP-NL compliant Dutch government
# concept vocabulary published with a public SPARQL endpoint. Each property shape below shares its
# sh:path with the matching property shape already declared in skos-ap-nl.ttl - SHACL (and this
# renderer's own childrenForShape/propertiesForShape, see shacl-everything's own CLAUDE.md) treats
# co-path property shapes as one logical property, so this only adds
# shui:searchQuery/sh:in/sh:node to that property rather than redefining it.
#
# Federated here: the Matching Relationships group (skos:broadMatch/narrowMatch/relatedMatch/
# closeMatch/exactMatch) and the isothes: (ISO 25964 skos-thes) generic/partitive/instantial
# relations - not plain skos:broader/narrower/related. skos-ap-nl.ttl's own
# skosapnl:MappingRelationsMisuse shape requires the Match properties to link concepts in
# *different* schemes, which is exactly what federating them against an external vocabulary like
# TOOI is for. skos-ap-nl.ttl itself groups the isothes: relations with plain broader/narrower
# (skosapnl:SemanticRelations/DisjointConceptAndCollection treat them as ordinary same-scheme
# relations, not cross-scheme like Match) - federating them here anyway is a deliberate choice to
# let a user reach into TOOI for these more specific relation types too, not a spec requirement.
#
# shui:searchQuery drives as-you-type search; sh:in's sh:select is the Dynamic-SHACL fallback for
# a renderer that doesn't support shui:searchQuery (spec §10.1). shui:editor is asserted
# explicitly, not left to shui:searchQuery's own scoring bonus, because that scoring path only
# checks a candidate *value*'s shui:isIRI shape - with no value yet (a brand new property with
# nothing filled in), that check can't pass, and EnumSelectEditor's un-gated "has an sh:in" score
# would otherwise win by default.
#
# Known gap (left alone for now): a value picked this way is never copied into the local
# dataGraph, so a constraint like sh:class that expects a local rdf:type triple for the value can
# render a perfectly legitimate pick as invalid.

skosapnl:TooiConceptLabelShape
  a sh:NodeShape ;
  sh:property [
    sh:path skos:prefLabel ;
    shui:propertyRole shui:LabelRole ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:path skos:definition ;
    shui:propertyRole shui:ClassificationRole ;
    sh:order 2 ;
  ] .

skosapnl:Concept-broadMatch-TooiFederated
  a sh:PropertyShape ;
  sh:path skos:broadMatch ;
  sh:node skosapnl:TooiConceptLabelShape ;
  shui:editor shui:AutoCompleteEditor ;
  shui:searchQuery """
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT DISTINCT ?value WHERE {
      SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
        ?value a skos:Concept ;
          (skos:prefLabel|skos:altLabel) ?searchLabel .
        BIND(IF(CONTAINS($uiLanguage, "-"), STRBEFORE($uiLanguage, "-"), $uiLanguage) AS ?uiPrimaryLanguage)
        FILTER(LANGMATCHES(LANG(?searchLabel), ?uiPrimaryLanguage))
        FILTER(CONTAINS(LCASE(?searchLabel), LCASE($searchTerm)))
      }
    }
  """ ;
  sh:in [
    sh:select """
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT DISTINCT ?value1 WHERE {
        SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
          ?value1 a skos:Concept .
        }
      }
      LIMIT 100
    """ ;
  ] .

