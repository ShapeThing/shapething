  a sh:PropertyShape ;
  sh:path skos:narrower ;
  sh:node skosapnl:TooiConceptLabelShape ;
  shui:editor shui:AutoCompleteEditor ;
  shui:searchQuery """
    PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
    SELECT DISTINCT ?value WHERE {
      SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
        ?value a skos:Concept ;
          (skos:prefLabel|skos:altLabel) ?searchLabel .
        BIND(IF(CONTAINS($uiLanguage, "-"), STRBEFORE($uiLanguage, "-"), $uiLanguage) AS ?uiPrimaryLanguage)
        FILTER(LANGMATCHES(LANG(?searchLabel), ?uiPrimaryLanguage))
        FILTER(CONTAINS(LCASE(?searchLabel), LCASE($searchTerm)))
      }
    }
  """ ;
  sh:in [
    sh:select """
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
