@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix ex: <http://example.org/>.

# A deliberately minimal skos:Concept shape, showing just the two things this demo is about: a
# local shui:AutoCompleteEditor field (skos:broader, searching skos:Concept instances already
# present in the local dataGraph) and a federated one (skos:broadMatch, searching the real TOOI
# thesaurus over SPARQL - the same public endpoint and shui:searchQuery
# skos-ap-nl-tooi-federation.ttl uses for the identical predicate). Each field links to another
# *Concept*, not a scheme directly - <#conceptLabelShape> below shows that concept's own
# skos:prefLabel as its LabelRole, and its skos:ConceptScheme itself (via the single-hop
# skos:inScheme) as a shui:ClassificationRole (rendered as a chip by LabelViewer/AutoCompleteOption,
# linking out to the scheme's own IRI). The scheme's *label* is then resolved as a second, separate
# step (valueNodeClassification/buildRoleLookupQuery's own nested lookup) - first via the concept's
# own LabelRole predicate (skos:prefLabel), falling back to plain rdfs:label - which is exactly what
# the federated field needs: TOOI isn't one uniform vocabulary but several thesauri (upl/kern/...),
# and they don't agree on how a ConceptScheme names itself - upl's schemes use rdfs:label (e.g.
# .../upl/Bestuurslagen), kern's use skos:prefLabel instead - so a real federated search's result
# set (unlike the one already-linked, hand-picked <#data> example below) mixes concepts from both;
# a single fixed predicate here would leave most of those rows without a chip.

<#conceptLabelShape>
  a sh:NodeShape ;
  sh:property [
    sh:path skos:prefLabel ;
    shui:propertyRole shui:LabelRole ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:path skos:inScheme ;
    shui:propertyRole shui:ClassificationRole ;
    sh:order 2 ;
  ] .

<#shape>
  a sh:NodeShape ;
  sh:targetClass skos:Concept ;
  sh:property [
    sh:name "Broader concept (local)"@en, "Breder begrip (lokaal)"@nl ;
    sh:path skos:broader ;
    sh:class skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:node <#conceptLabelShape> ;
    shui:editor shui:AutoCompleteEditor ;
    sh:order 1 ;
  ] ;
  sh:property [
    sh:name "Broad match (federated, TOOI)"@en, "Bredere overeenkomst (gefedereerd, TOOI)"@nl ;
    sh:path skos:broadMatch ;
    sh:class skos:Concept ;
    sh:nodeKind sh:IRI ;
    sh:node <#conceptLabelShape> ;
    shui:editor shui:AutoCompleteEditor ;
    # Mirrors skos-ap-nl-tooi-federation.ttl's own Concept-broadMatch-TooiFederated exactly - same
    # endpoint, same searchQuery/sh:in shape.
    shui:searchQuery """
      PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
      SELECT DISTINCT ?value WHERE {
        SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
          ?value a skos:Concept ;
            (skos:prefLabel|skos:altLabel) ?searchLabel .
          BIND(IF(CONTAINS($uiLanguage, "-"), STRBEFORE($uiLanguage, "-"), $uiLanguage) AS ?uiPrimaryLanguage)
          FILTER(LANGMATCHES(LANG(?searchLabel), ?uiPrimaryLanguage))
          FILTER(CONTAINS(LCASE(?searchLabel), LCASE($searchTerm)))
        }
      }
    """ ;
    sh:in [
      sh:select """
        PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
        SELECT DISTINCT ?value1 WHERE {
          SERVICE <https://standaarden.overheid.nl/tooi/sparql> {
            ?value1 a skos:Concept .
          }
        }
        LIMIT 100
      """ ;
    ] ;
    sh:order 2 ;
  ] .

<#data>
  a skos:Concept ;
  skos:prefLabel "Fiets"@nl, "Bicycle"@en ;
  skos:inScheme ex:transportScheme ;
  skos:broader ex:vervoermiddel ;
  # A real TOOI skos:Concept (https://identifier.overheid.nl/tooi/def/thes/upl/gemeente,
  # skos:prefLabel "gemeente"@nl, skos:inScheme .../Bestuurslagen, rdfs:label "Bestuurslagen"@nl -
  # TOOI only labels these in Dutch) - already linked so both its own label and its scheme's
  # ClassificationRole label resolve live against the federated endpoint on load, with no search
  # interaction needed.
  skos:broadMatch <https://identifier.overheid.nl/tooi/def/thes/upl/gemeente> .

ex:vervoermiddel a skos:Concept ;
  skos:prefLabel "Vervoermiddel"@nl, "Vehicle"@en ;
  skos:inScheme ex:transportScheme .

ex:dier a skos:Concept ;
  skos:prefLabel "Dier"@nl, "Animal"@en ;
  skos:inScheme ex:animalsScheme .

ex:transportScheme a skos:ConceptScheme ; rdfs:label "Vervoermiddelen"@nl, "Means of transport"@en .
ex:animalsScheme a skos:ConceptScheme ; rdfs:label "Dieren"@nl, "Animals"@en .
