@prefix ex: <http://example.org/>.
@prefix schema: <http://schema.org/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix st: <http://shapething.com/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:property [
        sh:name "Favourite topic"@en, "Favoriete onderwerp"@nl ;
        sh:path ex:favouriteTopic ;
        sh:class skos:Concept ;
        sh:node <#conceptShape> ;
        shui:editor shui:AutoCompleteEditor ;
    ] ;
    .

<#conceptShape>
    sh:property [
        sh:path skos:prefLabel ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        shui:propertyRole shui:ClassificationRole ;
    ] .

# Same as st-color-role-classification.ttl, but the swatch is an st:ColorEditor-style HSL blank
# node (st:hue/st:saturation/st:lightness) rather than a plain CSS color literal - converted to hex.
# st:ColorRole is resolved off the ClassificationRole value's OWN rdf:type (skos:ConceptScheme),
# not the property's sh:class (skos:Concept) - so it's declared on a shape targeting that class.
<#schemeShape>
    a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:property [
        sh:path skos:prefLabel ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path ex:swatch ;
        shui:propertyRole st:ColorRole ;
    ] .

<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    ex:favouriteTopic ex:bicycle .

ex:bicycle a skos:Concept ;
    skos:prefLabel "Bicycle"@en ;
    skos:inScheme ex:transportScheme .

ex:car a skos:Concept ;
    skos:prefLabel "Car"@en ;
    skos:inScheme ex:transportScheme .

ex:transportScheme a skos:ConceptScheme ;
    skos:prefLabel "Transport"@en ;
    ex:swatch [ st:hue 271 ; st:saturation 91 ; st:lightness 65 ] .
