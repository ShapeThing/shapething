@prefix ex: <http://example.org/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix st: <http://shapething.com/>.
### QUDT (Quantities, Units, Dimensions and Types) unit vocabulary - a real, dereferenceable
### ontology (https://qudt.org/), reused here instead of ad hoc unit strings so schema:unitCode
### values are grounded in something other than this fixture's own vocabulary. rdfs:label is
### asserted locally (in this graph) rather than fetched from qudt.org - an ordinary Linked Data
### pattern for labeling a shared external resource for one's own UI.
@prefix unit: <http://qudt.org/vocab/unit/>.

### Chef Shape
ex:ChefShape a sh:NodeShape ;
    sh:targetClass ex:Chef ;
    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        sh:name "Name"@en, "Naam"@nl ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:order 1 ;
        sh:name "Photo"@en, "Foto"@nl ;
        shui:viewer shui:ImageViewer ;
        shui:propertyRole shui:DepictionRole ;
    ] ;
    sh:property [
        sh:path schema:nationality ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 2 ;
        sh:name "Nationality"@en, "Nationaliteit"@nl ;
    ] ;
    sh:property [
        sh:path ex:cuisine ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 3 ;
        sh:name "Signature cuisine"@en, "Signatuurkeuken"@nl ;
    ] ;
    sh:property [
        sh:path ex:michelinStars ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:maxInclusive 3 ;
        sh:maxCount 1 ;
        sh:order 4 ;
        sh:name "Michelin stars"@en, "Michelinsterren"@nl ;
    ] ;
    sh:property [
        sh:path schema:worksFor ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 5 ;
        sh:name "Restaurant"@en, "Restaurant"@nl ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" "nl" ) ;
        sh:uniqueLang true ;
        sh:singleLine false ;
        sh:order 6 ;
        sh:name "Biography"@en, "Biografie"@nl ;
    ] ;
    sh:property [
        sh:path schema:sameAs ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:order 7 ;
        sh:name "Wikipedia"@en, "Wikipedia"@nl ;
    ] ;
    .

### Recipe categories and units of measurement are both closed sets of referenceable resources
### (not free-text strings) - ex:RecipeCategoryShape/ex:UnitShape below give each a proper node
### shape with an rdfs:label LabelRole, the same pattern used for the Chef reference (sh:class,
### resolved via valueNodeShapes) so EnumSelectEditor's options - and any viewer/chip that shows
### one - display a translated label instead of a raw enum string or IRI.
ex:RecipeCategoryShape a sh:NodeShape ;
    sh:targetClass ex:RecipeCategory ;
    sh:property [
        sh:path rdfs:label ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    .

ex:Starter a ex:RecipeCategory ; rdfs:label "Starter"@en, "Voorgerecht"@nl .
ex:MainCourse a ex:RecipeCategory ; rdfs:label "Main course"@en, "Hoofdgerecht"@nl .
ex:Dessert a ex:RecipeCategory ; rdfs:label "Dessert"@en, "Dessert"@nl .
ex:SideDish a ex:RecipeCategory ; rdfs:label "Side dish"@en, "Bijgerecht"@nl .

ex:UnitShape a sh:NodeShape ;
    sh:targetClass ex:Unit ;
    sh:property [
        sh:path rdfs:label ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    .

unit:KiloGM a ex:Unit ; rdfs:label "Kilogram"@en, "Kilogram"@nl .
unit:GM a ex:Unit ; rdfs:label "Gram"@en, "Gram"@nl .
unit:MilliL a ex:Unit ; rdfs:label "Milliliter"@en, "Milliliter"@nl .
unit:TBSP a ex:Unit ; rdfs:label "Tablespoon"@en, "Eetlepel"@nl .
unit:TSP a ex:Unit ; rdfs:label "Teaspoon"@en, "Theelepel"@nl .
unit:MIN a ex:Unit ; rdfs:label "Minutes"@en, "Minuten"@nl .
unit:COUNT a ex:Unit ; rdfs:label "Count"@en, "Aantal"@nl .

### A reusable schema:QuantitativeValue-shaped pair (schema:value + schema:unitCode) for any single
### measured quantity that isn't itself a value with a name of its own - prep/cook time (unitCode
### unit:MIN) and servings (unitCode unit:COUNT). Ingredients need a third field (their own name),
### so they get their own IngredientShape below instead of reusing this one.
ex:QuantityShape a sh:NodeShape ;
    sh:property [
        sh:path schema:value ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        sh:name "Amount"@en, "Aantal"@nl ;
        shui:propertyRole shui:LabelRole ;
        sh:group ex:quantityFieldsGroup ;
    ] ;
    sh:property [
        sh:path schema:unitCode ;
        sh:class ex:Unit ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        shui:editor shui:EnumSelectEditor ;
        sh:minCount 1 ;
        sh:order 1 ;
        sh:name "Unit"@en, "Eenheid"@nl ;
        sh:group ex:quantityFieldsGroup ;
    ] ;
    .

ex:quantityFieldsGroup a sh:PropertyGroup, st:HorizontalPropertyGroup ;
    .

### One recipeIngredient value: a name plus an optional quantity (schema:value/schema:unitCode) -
### some ingredients (a pinch of this, a component already reduced to a name) genuinely have no
### clean amount, hence sh:minCount 0 on both.
ex:IngredientShape a sh:NodeShape ;
    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 0 ;
        sh:name "Ingredient"@en, "Ingrediënt"@nl ;
        shui:propertyRole shui:LabelRole ;
        sh:group ex:ingredientFieldsGroup ;
    ] ;
    sh:property [
        sh:path schema:value ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:order 1 ;
        sh:name "Amount"@en, "Hoeveelheid"@nl ;
        sh:group ex:ingredientFieldsGroup ;
    ] ;
    sh:property [
        sh:path schema:unitCode ;
        sh:class ex:Unit ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        shui:editor shui:EnumSelectEditor ;
        sh:order 2 ;
        sh:name "Unit"@en, "Eenheid"@nl ;
        sh:group ex:ingredientFieldsGroup ;
    ] ;
    .

ex:ingredientFieldsGroup a sh:PropertyGroup, st:HorizontalPropertyGroup ;
    .

### Recipe Shape
ex:RecipeShape a sh:NodeShape ;
    sh:targetClass schema:Recipe ;
    sh:property [
        sh:path schema:name ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" "nl" ) ;
        sh:uniqueLang true ;
        sh:minCount 1 ;
        sh:order 0 ;
        sh:name "Recipe name"@en, "Naam van het recept"@nl ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path schema:image ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
        sh:order 1 ;
        sh:name "Photo"@en, "Foto"@nl ;
        shui:viewer shui:ImageViewer ;
    ] ;
    sh:property [
        sh:path schema:author ;
        sh:class ex:Chef ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 2 ;
        sh:name "Chef"@en, "Chef-kok"@nl ;
    ] ;
    sh:property [
        sh:path schema:recipeCuisine ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:order 3 ;
        sh:name "Cuisine"@en, "Keuken"@nl ;
    ] ;
    sh:property [
        sh:path schema:recipeCategory ;
        sh:class ex:RecipeCategory ;
        sh:nodeKind sh:IRI ;
        sh:in ( ex:Starter ex:MainCourse ex:Dessert ex:SideDish ) ;
        sh:maxCount 1 ;
        sh:order 4 ;
        sh:name "Category"@en, "Categorie"@nl ;
    ] ;
    sh:property [
        sh:path schema:prepTime ;
        sh:nodeKind sh:BlankNode ;
        sh:node ex:QuantityShape ;
        shui:editor shui:DetailsEditor ;
        sh:maxCount 1 ;
        sh:order 5 ;
        sh:name "Prep time"@en, "Bereidingstijd"@nl ;
    ] ;
    sh:property [
        sh:path schema:cookTime ;
        sh:nodeKind sh:BlankNode ;
        sh:node ex:QuantityShape ;
        shui:editor shui:DetailsEditor ;
        sh:maxCount 1 ;
        sh:order 6 ;
        sh:name "Cook time"@en, "Kooktijd"@nl ;
    ] ;
    sh:property [
        sh:path schema:recipeYield ;
        sh:nodeKind sh:BlankNode ;
        sh:node ex:QuantityShape ;
        shui:editor shui:DetailsEditor ;
        sh:maxCount 1 ;
        sh:order 7 ;
        sh:name "Servings"@en, "Porties"@nl ;
    ] ;
    sh:property [
        sh:path schema:recipeIngredient ;
        sh:memberShape [
            sh:node ex:IngredientShape ;
            shui:editor shui:DetailsEditor ;
        ] ;
        sh:minListLength 1 ;
        sh:order 8 ;
        sh:name "Ingredients"@en, "Ingrediënten"@nl ;
    ] ;
    sh:property [
        sh:path schema:recipeInstructions ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" "nl" ) ;
        sh:uniqueLang true ;
        sh:singleLine false ;
        sh:minCount 1 ;
        sh:order 9 ;
        sh:name "Instructions"@en, "Bereidingswijze"@nl ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:datatype rdf:langString ;
        sh:languageIn ( "en" "nl" ) ;
        sh:uniqueLang true ;
        sh:singleLine false ;
        sh:order 10 ;
        sh:name "Description"@en, "Beschrijving"@nl ;
    ] ;
    .

