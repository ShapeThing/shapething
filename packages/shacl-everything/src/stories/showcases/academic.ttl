@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dbo: <http://dbpedia.org/ontology/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix foaf: <http://xmlns.com/foaf/0.1/>.
@prefix ex: <http://example.org/>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dbr: <http://dbpedia.org/resource/> .

### Organization
ex:UniX a schema:Organization ;
    schema:name "University of Exampleland" ;
    schema:location "Example City, EU" ;
    schema:identifier "UX-001" ;
    org:classification "university" .

### Organization
ex:UniY a schema:Organization ;
    schema:name "University of Exampleland2" ;
    schema:location "Example City, EU" ;
    schema:identifier "UX-002" ;
    org:classification "university" .


### Researcher (Person)
<#data> a schema:Person, foaf:Person ;
    foaf:name "Alice Example" ;
    foaf:mbox "alice@example.org" ;
    foaf:gender "female" ;
    schema:jobTitle "Assistant Professor" ;
    schema:affiliation ( ex:UniX ex:UniY ) ;
    schema:nationality dbr:Germany ;
    schema:sameAs <https://orcid.org/0000-0002-1825-0097> ,
                  <https://scholar.google.com/citations?user=xyz> .

### Publication
ex:pub1 a bibo:Document ;
    dc:title "A SHACL-based Form Generation System" ;
    dc:date "2024-11-01"^^xsd:date ;
    bibo:doi "10.1234/example.doi" ;
    bibo:abstract "This paper explores automated form generation using SHACL with semantic ontologies." ;
    bibo:DocumentType "conference" ;
    schema:author <#data> .

ex:pub2 a bibo:Document ;
    dc:title "Semantic Web Technologies in Higher Education" ;
    dc:date "2023-06-15"^^xsd:date ;
    bibo:DocumentType "journal" ;
    schema:author <#data> .


### Person Shape
ex:PersonShape a sh:NodeShape ;
    sh:targetClass foaf:Person ;
    sh:property [
        sh:path foaf:name ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:order 1;
        sh:group <#person> ;
        sh:name "Full Name"@en, "Volledige naam"@nl ;
        sh:description "The full name of the person."@en, "De volledige naam van de persoon."@nl ;
    ] ;
    sh:property [
        sh:path foaf:mbox ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:group <#person> ;
        sh:order 2;
        sh:name "Email Address"@en, "E-mailadres"@nl ;
        sh:description "A contact email."@en, "Een contact-e-mailadres."@nl ;
    ] ;

    sh:property [
        sh:path foaf:gender ;
        sh:in ("male" "female" "nonbinary" "prefer_not_to_say") ;
        sh:maxCount 1 ;
        sh:group <#person> ;
        sh:datatype xsd:string ;
        sh:order 3;
        sh:name "Gender"@en, "Geslacht"@nl ;
        sh:description "Select gender."@en, "Selecteer geslacht."@nl ;
    ] ;
.


<#person>
    sh:name "Person"@en, "Persoon"@nl ;
    sh:description "All about the person"@en, "Alles over de persoon"@nl;
	a sh:PropertyGroup ;
	sh:order 1 .


<#academic>
    sh:description "Academic achievements and external links"@en, "Academische prestaties en externe links"@nl;
    sh:name "Academic"@en, "Academisch"@nl ;
	a sh:PropertyGroup ;
	sh:order 2 .


### Researcher Shape (inherits Person)
ex:ResearcherShape a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:node ex:PersonShape ;
    sh:property [
        sh:path schema:jobTitle ;
        sh:datatype xsd:string ;
        sh:group <#person> ;
        sh:maxCount 1 ;
        sh:order 4;
        sh:name "Job Title"@en, "Functietitel"@nl ;
    ] ;
    sh:property [
        sh:path ( schema:affiliation [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
        sh:class schema:Organization ;
        sh:group <#academic> ;
        sh:minCount 1 ;
        sh:order 5;
        sh:name "Affiliated Organization"@en, "Aangesloten organisatie"@nl ;
        sh:description "Choose the institution where the researcher works."@en, "Kies de instelling waar de onderzoeker werkt."@nl ;
    ] ;
    sh:property [
        sh:path schema:nationality ;
        sh:in [
            sh:select """
                PREFIX dbo: <http://dbpedia.org/ontology/>
                PREFIX dbp: <http://dbpedia.org/property/>
                PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
                PREFIX dct: <http://purl.org/dc/terms/>
                PREFIX dbc: <http://dbpedia.org/resource/Category:>

                SELECT DISTINCT ?country ?label WHERE {
                    SERVICE <https://dbpedia.org/sparql> {
                        ?country a dbo:Country ;
                                rdfs:label ?label .

                        # Ensure the label is in English
                        FILTER (lang(?label) = "en")

                        # Require at least ONE modern validation signal
                        FILTER EXISTS {
                            { ?country dct:subject dbc:Member_states_of_the_United_Nations }
                            UNION
                            { ?country dct:subject dbc:Sovereign_states }
                            UNION
                            { ?country dbp:iso3166code ?iso }
                            UNION
                            { ?country dbo:cca2 ?cca2 }
                        }

                        # Exclude entities with explicit end/dissolution dates or years
                        FILTER NOT EXISTS { ?country dbo:dissolutionYear ?dYear }
                        FILTER NOT EXISTS { ?country dbo:dissolutionDate ?dDate }
                        FILTER NOT EXISTS { ?country dbp:yearEnd ?yEnd }
                    }
                }
                ORDER BY ?label
            """
        ] ;        
        sh:node [
            sh:property [
                sh:path rdfs:label ;
                sh:minCount 1 ;
                sh:datatype xsd:string ;
                sh:maxCount 1 ;
                sh:name "Country Name"@en, "Landnaam"@nl ;
                shui:propertyRole shui:LabelRole ;
            ] ;

            sh:property [
                sh:path dbo:thumbnail ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:name "Country flag"@en, "Vlag van het land"@nl ;
                shui:propertyRole shui:DepictionRole ;
            ] ;
        ] ;
        sh:nodeKind sh:IRI ;
        sh:group <#person> ;
        sh:order 6;
        sh:minCount 1 ;
        sh:name "Nationality"@en, "Nationaliteit"@nl ;
        sh:description "Link to a country IRI (e.g., ISO 3166 vocabulary)."@en, "Link naar een land-IRI (bijv. ISO 3166-vocabulaire)."@nl ;
    ] ;

    sh:property [
        sh:path [ sh:inversePath schema:author ] ;
        sh:order 5 ;
        sh:nodeKind sh:IRI ;
        sh:class bibo:Document ;
        sh:group <#academic> ;
        sh:name "Publications"@en, "Publicaties"@nl ;
    ] ;

    sh:property [
        sh:path schema:sameAs ;
        sh:group <#academic> ;
        sh:order 7;
        sh:name "External Profile URLs"@en, "Externe profiel-URL's"@nl ;
        sh:description "Links to ORCID, Google Scholar, etc."@en, "Links naar ORCID, Google Scholar, enz."@nl ;
    ] ;
.

### Publication Shape
ex:PublicationShape a sh:NodeShape ;
    sh:targetClass bibo:Document ;
    sh:property [
        sh:path dc:title ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:name "Title"@en, "Titel"@nl ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path dc:date ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
        sh:name "Publication Date"@en, "Publicatiedatum"@nl ;
    ] ;
    sh:property [
        sh:path bibo:doi ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "DOI"@en, "DOI"@nl ;
    ] ;
    sh:property [
        sh:path bibo:abstract ;
        dash:singleLine false ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:name "Abstract"@en, "Samenvatting"@nl ;
    ] ;
    sh:property [
        sh:path bibo:DocumentType ;
        sh:in ("journal" "conference" "thesis" "book" "other") ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Type"@en, "Type"@nl ;
    ] ;
    sh:property [
        sh:path schema:author ;
        sh:class schema:Person ;
        sh:minCount 1 ; 
        sh:name "Author(s)"@en, "Auteur(s)"@nl ;
    ] .

### Organization Shape
ex:OrganizationShape a sh:NodeShape ;
    sh:targetClass schema:Organization ;
    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Organization Name"@en, "Organisatienaam"@nl ;
        shui:propertyRole shui:LabelRole ;
    ] ;
    sh:property [
        sh:path schema:location ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Location"@en, "Locatie"@nl ;
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:datatype xsd:string ;
        sh:name "Org ID"@en, "Org-ID"@nl ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path org:classification ;
        sh:in ("university" "research_institute" "company" "government" "nonprofit") ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:minCount 1 ;
        sh:name "Type of Organization"@en, "Type organisatie"@nl ;
    ] .
