@prefix ex: <http://example.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix st: <http://shapething.com/>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Product ;
    sh:property [
        sh:name "Search"@en ;
        sh:path [ sh:alternativePath ( schema:name schema:description ) ] ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:name "Category"@en ;
        sh:path schema:category ;
        sh:class ex:Category ;
        sh:order 1 ;
    ] ;
    # st:ColorFacet is opt-in (see its own score.ttl) - the same schema:color property <#viewShape>
    # below uses for st:ColorViewer, just with an explicit st:facet declaration alongside it.
    sh:property [
        sh:name "Color"@en ;
        sh:path schema:color ;
        st:facet st:ColorFacet ;
        sh:order 2 ;
    ] ;
    sh:property [
        sh:name "Price"@en ;
        sh:path schema:price ;
        sh:datatype xsd:decimal ;
        sh:order 3 ;
    ] ;
    .

# Same target/fields as <#shape>, minus its facet-only "Search" alternativePath property (a plain
# Name/Description pair instead) - used to render one matching product as a clean result card
# (see webshop.stories.tsx), the same "separate view shape" convention recipes-and-chefs.ttl's own
# ex:RecipeViewShape uses.
<#viewShape>
    a sh:NodeShape ;
    sh:targetClass schema:Product ;
    sh:property [
        sh:name "Name"@en ;
        sh:path schema:name ;
        sh:order 0 ;
    ] ;
    sh:property [
        sh:name "Description"@en ;
        sh:path schema:description ;
        sh:order 1 ;
    ] ;
    sh:property [
        sh:name "Category"@en ;
        sh:path schema:category ;
        sh:class ex:Category ;
        sh:order 2 ;
    ] ;
    # st:ColorViewer is shui:viewer-only, opt-in (see its own score.ttl) - schema:color's value is
    # a blank node carrying st:hue/st:saturation/st:lightness (genuine CSS HSL notation), not a hex
    # literal - see st:ColorEditor/widget.tsx's own doc comment.
    sh:property [
        sh:name "Color"@en ;
        sh:path schema:color ;
        shui:viewer st:ColorViewer ;
        sh:order 3 ;
    ] ;
    sh:property [
        sh:name "Price"@en ;
        sh:path schema:price ;
        sh:datatype xsd:decimal ;
        sh:order 4 ;
    ] ;
    .

ex:TShirts a ex:Category ; rdfs:label "T-Shirts"@en .
ex:Jackets a ex:Category ; rdfs:label "Jackets"@en .
ex:Jeans a ex:Category ; rdfs:label "Jeans"@en .
ex:Sneakers a ex:Category ; rdfs:label "Sneakers"@en .
ex:Sweaters a ex:Category ; rdfs:label "Sweaters"@en .
ex:Accessories a ex:Category ; rdfs:label "Accessories"@en .
ex:Dresses a ex:Category ; rdfs:label "Dresses"@en .

