dcatapnl-sh:DatasetShape_issued sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_sample sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_source sh:group dcatshow:DatasetShapeDrawer .
