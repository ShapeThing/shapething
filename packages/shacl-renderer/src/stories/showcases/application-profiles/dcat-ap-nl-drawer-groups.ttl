dcatapnl-sh:DatasetShape_accrualPeriodicity sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_hasVersion sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_inSeries sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_isReferencedBy sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_landingPage sh:group dcatshow:DatasetShapeDrawer .
