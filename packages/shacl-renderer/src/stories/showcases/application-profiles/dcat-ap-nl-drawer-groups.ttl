@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix st: <http://shapething.com/> .
@prefix dcatapnl-sh: <http://modellen.geostandaarden.nl/dcat-ap-nl/id/shape/> .
@prefix dcatshow: <https://shapething.com/showcases/dcat-ap-nl#> .

# Overlay for the DCAT AP NL showcase (Showcases/Application profiles/DCAT AP NL), same approach as
# the RDA-FR showcase's own rdafr-shacl-drawer-groups.ttl: adds one st:DrawerPropertyGroup per
# showcased shape and moves that shape's own optional (no sh:minCount >= 1, as declared across
# dcat-ap-nl-SHACL.ttl's constraint-only property shapes for the same sh:path) properties into it -
# via sh:group triples on dcat-ap-nl-LBL.ttl's existing named property shapes, without editing either
# generated file in place. Required properties are left out of the group and stay directly visible.
# Loaded alongside the other profile files via argsByTestFile's multi-file merge in dcat.stories.tsx.

# Dataset: 6 required (accessRights, contactPoint, creator, identifier, publisher, theme), 32 optional
dcatshow:DatasetShapeDrawer a sh:PropertyGroup, st:DrawerPropertyGroup ;
    sh:order 1000 ;
    sh:name "Overige eigenschappen"@nl .

dcatapnl-sh:DatasetShape_description sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_title sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_distribution sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_spatial sh:group dcatshow:DatasetShapeDrawer .
