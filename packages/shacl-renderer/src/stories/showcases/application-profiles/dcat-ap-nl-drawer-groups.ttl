dcatapnl-sh:DatasetShape_modified sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_other_identifier sh:group dcatshow:DatasetShapeDrawer .
dcatapnl-sh:DatasetShape_provenance sh:group dcatshow:DatasetShapeDrawer .
