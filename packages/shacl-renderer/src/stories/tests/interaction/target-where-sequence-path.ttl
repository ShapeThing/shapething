@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix ex: <http://example.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.

### sh:targetWhere (3.1.3.6) fixture whose discriminator sits one hop away from the focus node:
### each fragment's where-target inspects the sequence path (ex:details ex:kind), so the triple that
### decides which fragment attaches is <details> ex:kind "...", not anything on <#data> itself.
### Editing "Kind" (rendered inline under "Details") must still re-evaluate the fragments - see
### useTargetWhereFragments.tsx, which walks each watched path through the data so every hop is
### tracked, not only the focus node's own triples.
<#shape> a sh:NodeShape ;
    sh:targetClass ex:Thing ;
    sh:property [
        sh:path ex:details ;
        sh:nodeKind sh:BlankNodeOrIRI ;
        sh:maxCount 1 ;
        sh:name "Details" ;
        shui:editor shui:DetailsEditor ;
        sh:node [
            sh:property [
                sh:path ex:kind ;
                sh:in ("A" "B") ;
                sh:datatype xsd:string ;
                sh:minCount 1 ;
                sh:maxCount 1 ;
                sh:name "Kind" ;
            ] ;
        ] ;
    ] .

ex:FragmentAShape a sh:NodeShape ;
    sh:targetWhere [
        sh:property [ sh:path ( ex:details ex:kind ) ; sh:hasValue "A" ] ;
    ] ;
    sh:property [
        sh:path ex:extraA ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Extra A" ;
    ] .

ex:FragmentBShape a sh:NodeShape ;
    sh:targetWhere [
        sh:property [ sh:path ( ex:details ex:kind ) ; sh:hasValue "B" ] ;
    ] ;
    sh:property [
        sh:path ex:extraB ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:name "Extra B" ;
    ] .

<#data> a ex:Thing ;
    ex:details [ ex:kind "A" ] ;
    ex:extraA "hello" .
