PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

shui:ImageViewer rdfs:label "Image"@en, "Afbeelding"@nl .

shui:imageViewerScore20
    a shui:WidgetScore ;
    shui:viewer shui:ImageViewer ;
    shui:score 20 ;
    shui:dataGraphShape shui:hasImageFileExtension ;
.
