@prefix ex: <http://example.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <http://schema.org/>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix shui: <http://www.w3.org/ns/shacl-ui/>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.

<#shape>
    a sh:NodeShape ;
    sh:targetClass schema:Person ;

    sh:property [
        sh:name "Employer"@en ;
        sh:path ex:employer ;
        sh:class schema:Organization ;
        shui:viewer shui:LabelViewer ;
    ] ;
    .

<#organizationShape>
    a sh:NodeShape ;
    sh:targetClass schema:Organization ;

    sh:property [
        sh:name "Email"@en ;
        sh:path schema:email ;
        sh:datatype xsd:string ;
    ] ;

    sh:property [
        sh:name "CEO"@en ;
        sh:path ex:ceo ;
        sh:class schema:Person ;
        shui:viewer shui:LabelViewer ;
    ] ;
    .

<#data>
    a schema:Person ;
    schema:givenName "Hendrik" ;
    ex:employer ex:acme ;
    .

ex:acme a schema:Organization ;
    rdfs:label "ACME Corp"@en ;
    schema:email "info@acme.example" ;
    ex:ceo ex:jane .

ex:jane a schema:Person ;
    rdfs:label "Jane Doe"@en ;
    schema:givenName "Jane" .
