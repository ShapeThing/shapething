PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX sh: <http://www.w3.org/ns/shacl#>

st:PropertyEditor
    a shui:Editor ;
    rdfs:isDefinedBy st: ;
    rdfs:label "Property editor"@en, "Eigenschappeneditor"@nl .

# A node shape's own sh:property values - the properties of the shape being edited.
st:propertyEditorScore50
    a shui:WidgetScore ;
    shui:editor st:PropertyEditor ;
    shui:score 50 ;
    shui:shapesGraphShape [
        a sh:NodeShape ;

        sh:property [
            sh:path sh:path ;
            sh:hasValue sh:property ;
        ] ;
    ] ;
.
