PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

st:SubClassFacet rdfs:label "Class Picker"@en, "Klassekiezer"@nl .

st:subClassFacetScoreRootClass
    a shui:WidgetScore ;
    st:facet st:SubClassFacet ;
    shui:score 20 ;
    shui:shapesGraphShape shui:hasRootClassConstraint ;
.
