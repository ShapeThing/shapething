PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX shui: <http://www.w3.org/ns/shacl-ui/>
PREFIX st: <http://shapething.com/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

st:VideoViewer rdfs:label "Video"@en, "Video"@nl .

# Same score as shui:ImageViewer's file extension rule: a value ending in a video file extension
# beats the generic IRI/literal viewers.
st:videoViewerScore20
    a shui:WidgetScore ;
    shui:viewer st:VideoViewer ;
    shui:score 20 ;
    shui:dataGraphShape st:hasVideoFileExtension ;
.

st:hasVideoFileExtension
    a sh:NodeShape ;
    sh:or (
        [
            sh:nodeKind sh:IRI
        ]
        [
            sh:nodeKind sh:Literal
        ]
    ) ;
    sh:pattern "\\.(mp4|m4v|webm|ogv|mov)$" ;
    sh:flags "i" ;
.
